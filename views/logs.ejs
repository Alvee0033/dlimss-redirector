<div class="max-w-6xl mx-auto px-4 sm:px-6 py-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Activity Logs</h1>
      <p class="text-slate-600 text-sm mt-1">
        Recent QR scans and redirect visits.
      </p>
    </div>

    <form method="POST" action="/admin/logs/clear" onsubmit="return confirm('Clear all logs?');">
      <button type="submit" class="text-sm font-bold px-4 py-2.5 rounded-xl bg-rose-50 text-rose-700 border border-rose-200 hover:bg-rose-100 transition flex items-center gap-2">
        <i class="fa-solid fa-trash text-xs"></i>
        <span>Clear Logs</span>
      </button>
    </form>
  </div>

  <% if (logs.length === 0) { %>
    <div class="py-16 text-center text-slate-500 bg-white border border-slate-200 rounded-2xl p-6">
      <p class="text-lg font-bold text-slate-700">No logs yet</p>
      <p class="text-sm mt-1 text-slate-500">Scan any generated QR or visit a redirect URL to see entries</p>
    </div>
  <% } else { %>

    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
      <div class="p-4 sm:p-5 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
        <h2 class="text-base font-bold text-slate-800">Visit History (<%= logs.length %>)</h2>
      </div>

      <div class="divide-y divide-slate-200">
        <% logs.forEach(log => { %>
          <div class="p-4 sm:p-5 hover:bg-slate-50 transition flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-sm">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-mono text-sm font-bold bg-blue-100 text-blue-800 px-2.5 py-0.5 rounded-lg">
                  <%= log.incoming_path || log.matched_type %>
                </span>
                <% if (log.incoming_query) { %>
                  <span class="font-mono text-xs text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                    ?<%= log.incoming_query %>
                  </span>
                <% } %>
                <span class="text-xs text-slate-400">
                  <%= new Date(log.timestamp).toLocaleString() %>
                </span>
              </div>
              <div class="font-mono text-xs text-slate-600 mt-1 truncate" title="<%= log.forwarded_to %>">
                Forwarded &rarr; <%= log.forwarded_to %>
              </div>
            </div>

            <div class="text-xs text-slate-500 text-right sm:self-center font-mono">
              <%= log.ip || 'Unknown IP' %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

  <% } %>

</div>
