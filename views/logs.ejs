<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Real-Time Click Logs</h1>
      <p class="text-slate-400 text-sm mt-1">Audit trail showing who visited, what query params were passed (?refid=...), and where they went.</p>
    </div>

    <form method="POST" action="/admin/logs/clear" onsubmit="return confirm('Clear all click logs?');">
      <button type="submit" class="text-xs font-semibold px-3 py-2 rounded-xl bg-rose-500/10 text-rose-400 border border-rose-500/20 hover:bg-rose-500/20 transition flex items-center gap-2">
        <i class="fa-solid fa-trash"></i>
        <span>Clear Logs</span>
      </button>
    </form>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
    <% if (logs.length === 0) { %>
      <div class="py-16 text-center text-slate-500">
        <i class="fa-solid fa-hourglass-start text-4xl mb-3 text-slate-700"></i>
        <p class="text-base font-medium text-slate-400">No clicks recorded yet</p>
        <p class="text-xs mt-1">Visit any short link to start tracking redirection traffic</p>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/60 text-slate-400 uppercase tracking-wider border-b border-slate-800">
            <tr>
              <th class="px-5 py-3 font-semibold">Timestamp</th>
              <th class="px-5 py-3 font-semibold">Slug / Source</th>
              <th class="px-5 py-3 font-semibold">Forwarded Full Destination</th>
              <th class="px-5 py-3 font-semibold">Query Passed</th>
              <th class="px-5 py-3 font-semibold">IP & Device</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800/60">
            <% logs.forEach(log => { %>
              <tr class="hover:bg-slate-800/20 transition">
                <td class="px-5 py-3 text-slate-400 whitespace-nowrap">
                  <%= new Date(log.timestamp).toLocaleString() %>
                </td>
                <td class="px-5 py-3 font-mono font-medium text-indigo-400">
                  /<%= log.slug %>
                </td>
                <td class="px-5 py-3 max-w-sm truncate font-mono text-slate-300" title="<%= log.forwarded_to %>">
                  <%= log.forwarded_to %>
                </td>
                <td class="px-5 py-3 font-mono">
                  <% if (log.incoming_query) { %>
                    <span class="text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                      ?<%= log.incoming_query %>
                    </span>
                  <% } else { %>
                    <span class="text-slate-600">none</span>
                  <% } %>
                </td>
                <td class="px-5 py-3 text-slate-400">
                  <div class="text-[11px] text-slate-300 font-mono"><%= log.ip %></div>
                  <div class="text-[10px] text-slate-500 truncate max-w-xs" title="<%= log.user_agent %>"><%= log.user_agent %></div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
