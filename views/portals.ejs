<div class="max-w-6xl mx-auto px-4 py-6">

  <!-- Header Banner -->
  <div class="bg-slate-900 text-white rounded-2xl p-5 sm:p-6 mb-6 shadow-sm border border-slate-800">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Live System Registry</span>
        </div>
        <h1 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
          Destination Portals & Admin Access
        </h1>
        <p class="text-slate-400 text-xs sm:text-sm mt-1">
          Direct administrator logins and one-click copyable credentials for all connected systems.
        </p>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-xs font-bold px-3 py-1.5 rounded-xl bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
          <%= sites.filter(s => s.is_active).length %> Online
        </span>
        <span class="text-xs font-bold px-3 py-1.5 rounded-xl bg-slate-800 text-slate-300 border border-slate-700">
          <%= sites.reduce((acc, s) => acc + (s.total_clicks || 0), 0) %> Scans
        </span>
      </div>
    </div>
  </div>

  <!-- Search Filter -->
  <div class="mb-6 relative">
    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
      <i class="fa-solid fa-magnifying-glass text-sm"></i>
    </div>
    <input 
      type="text" 
      id="portal-search" 
      oninput="filterPortals()" 
      placeholder="Search by country, title, or keyword..." 
      class="w-full rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-900 bg-white border border-slate-200 shadow-xs focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition"
    >
  </div>

  <!-- Cards Grid -->
  <div id="portals-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <% 
      const getMeta = (key) => {
        key = (key || '').toLowerCase();
        if (key.includes('dari')) {
          return {
            logo: '/logos/dari.svg',
            type: 'image',
            badge: 'UAE ADREC',
            badgeClass: 'bg-emerald-50 text-emerald-800 border-emerald-200',
            adminUrl: 'https://dari-ace.com/login',
            user: 'officer@adrec.gov.ae',
            pass: 'admin123',
            desc: 'Real estate contract & document verification portal'
          };
        }
        if (key.includes('bd')) {
          return {
            logo: '/logos/bd.png',
            type: 'image',
            badge: 'Bangladesh BRTA',
            badgeClass: 'bg-green-50 text-green-800 border-green-200',
            adminUrl: 'http://ewqqphsfrvznx2wabg1dgoej.163.227.239.97.sslip.io/login',
            user: 'admin@brta.gov.bd',
            pass: 'admin123',
            desc: 'BRTA Smart Driving Licence card verification portal'
          };
        }
        if (key.includes('pk')) {
          return {
            logo: '/logos/pk.png',
            type: 'image',
            badge: 'KPK Police',
            badgeClass: 'bg-teal-50 text-teal-800 border-teal-200',
            adminUrl: 'https://kpk.dlimsvr.com/admin',
            user: 'admin',
            pass: 'admin',
            desc: 'KPK traffic police driving license system'
          };
        }
        if (key.includes('pakistan')) {
          return {
            logo: '/logos/pakistan.png',
            type: 'image',
            badge: 'Islamabad Police',
            badgeClass: 'bg-emerald-50 text-emerald-800 border-emerald-200',
            adminUrl: 'https://pakistan.dlimsvr.com/admin/login',
            user: 'admin@dlims.gov',
            pass: 'dlims@admin2024',
            desc: 'Islamabad Capital Territory DLIMS'
          };
        }
        if (key.includes('india')) {
          return {
            logo: '/logos/india.png',
            type: 'image',
            badge: 'Sarathi Parivahan',
            badgeClass: 'bg-orange-50 text-orange-800 border-orange-200',
            adminUrl: 'https://sarathiparivahn.com/admin/login',
            user: 'admin@dlims.gov',
            pass: 'dlims@admin2024',
            desc: 'Ministry of Road Transport & Highways DL Portal'
          };
        }
        if (key.includes('afghan')) {
          return {
            logo: '/logos/afghan.webp',
            type: 'image',
            badge: 'Afghanistan Traffic',
            badgeClass: 'bg-red-50 text-red-800 border-red-200',
            adminUrl: 'https://afgani.dlimsvr.com/login',
            user: 'admin',
            pass: 'admin123',
            desc: 'Traffic Police Directorate Driving License Portal'
          };
        }
        if (key.includes('card')) {
          return {
            logo: '/logos/card.svg',
            type: 'image',
            badge: 'Card Studio',
            badgeClass: 'bg-indigo-50 text-indigo-800 border-indigo-200',
            adminUrl: 'http://c9cdcow274htjl1cb71aph7c.163.227.239.97.sslip.io',
            user: 'Public Studio',
            pass: 'No Password Required',
            desc: '2-Page Interactive Card Generator & PDF Studio'
          };
        }
        return {
          icon: 'fa-solid fa-globe',
          type: 'icon',
          badge: 'External',
          badgeClass: 'bg-slate-50 text-slate-800 border-slate-200',
          adminUrl: '',
          user: 'admin',
          pass: 'admin123',
          desc: 'External verification site'
        };
      };
    %>

    <% sites.forEach(site => { 
      const meta = getMeta(site.key_name);
    %>
      <div class="portal-card bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs hover:border-slate-300 transition flex flex-col justify-between">
        
        <!-- Header: Logo + Title + Slug -->
        <div>
          <div class="flex items-start gap-3.5 mb-3">
            <!-- Normal Square Logo Box -->
            <div class="w-12 h-12 min-w-[48px] max-w-[48px] h-[48px] max-h-[48px] rounded-xl bg-slate-50 border border-slate-200 p-2 flex items-center justify-center flex-shrink-0">
              <% if (meta.type === 'image') { %>
                <img src="<%= meta.logo %>" alt="<%= site.title %>" class="w-full h-full object-contain block">
              <% } else { %>
                <i class="<%= meta.icon %> text-lg text-slate-600"></i>
              <% } %>
            </div>

            <!-- Title & Badge -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-1 mb-1">
                <span class="font-mono text-[11px] font-extrabold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-md truncate">
                  /<%= site.key_name %>
                </span>
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-md border <%= meta.badgeClass %>">
                  <%= meta.badge %>
                </span>
              </div>
              <h2 class="portal-name font-bold text-sm sm:text-base text-slate-900 leading-snug truncate" title="<%= site.title %>">
                <%= site.title %>
              </h2>
            </div>
          </div>

          <!-- Description / Subtitle -->
          <p class="text-xs text-slate-500 mb-3 line-clamp-1">
            <%= meta.desc %>
          </p>

          <!-- Destination URL Box -->
          <div class="bg-slate-50 border border-slate-200/80 rounded-xl px-3 py-2 text-xs flex items-center justify-between gap-2 mb-3">
            <span class="font-mono text-[11px] text-slate-600 truncate flex-1" title="<%= site.base_url %>">
              <%= site.base_url %>
            </span>
            <span class="text-[10px] font-bold text-slate-400 bg-white border border-slate-200 px-1.5 py-0.5 rounded flex-shrink-0">
              <%= site.total_clicks || 0 %> scans
            </span>
          </div>

          <!-- Credentials Box -->
          <div class="bg-amber-50/60 border border-amber-200/80 rounded-xl p-3 mb-3 text-xs space-y-1.5">
            <div class="text-[10px] font-bold uppercase tracking-wider text-amber-900 flex items-center justify-between">
              <span class="flex items-center gap-1.5">
                <i class="fa-solid fa-key text-amber-600"></i>
                <span>Admin Login Credentials</span>
              </span>
              <% if (meta.adminUrl) { %>
                <a href="<%= meta.adminUrl %>" target="_blank" class="text-[11px] font-bold text-blue-600 hover:underline">
                  Open Login ↗
                </a>
              <% } %>
            </div>

            <!-- Username Row -->
            <div class="flex items-center justify-between bg-white border border-amber-100 rounded-lg px-2.5 py-1.5">
              <span class="text-slate-400 text-[11px] font-semibold">User:</span>
              <div class="flex items-center gap-2 max-w-[75%]">
                <code class="font-mono text-xs font-bold text-slate-800 truncate"><%= meta.user %></code>
                <% if (meta.user !== 'Public Studio') { %>
                  <button type="button" onclick="copyToClipboard('<%= meta.user %>')" class="text-slate-400 hover:text-slate-700 p-0.5" title="Copy User">
                    <i class="fa-regular fa-copy text-xs"></i>
                  </button>
                <% } %>
              </div>
            </div>

            <!-- Password Row -->
            <div class="flex items-center justify-between bg-white border border-amber-100 rounded-lg px-2.5 py-1.5">
              <span class="text-slate-400 text-[11px] font-semibold">Pass:</span>
              <div class="flex items-center gap-2 max-w-[75%]">
                <code class="font-mono text-xs font-bold text-slate-800 truncate"><%= meta.pass %></code>
                <% if (meta.pass !== 'No Password Required') { %>
                  <button type="button" onclick="copyToClipboard('<%= meta.pass %>')" class="text-slate-400 hover:text-slate-700 p-0.5" title="Copy Password">
                    <i class="fa-regular fa-copy text-xs"></i>
                  </button>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="pt-3 border-t border-slate-100 space-y-2">
          <a 
            href="<%= meta.adminUrl || site.base_url %>" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white flex items-center justify-center gap-1.5 transition shadow-xs"
          >
            <span>Launch Dashboard</span>
            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
          </a>

          <div class="grid grid-cols-2 gap-2">
            <button 
              type="button" 
              onclick="showQR(<%= site.id %>, '<%= site.key_name %>', '<%= site.title %>')"
              class="py-2 px-3 rounded-lg text-xs font-bold bg-slate-50 text-slate-700 border border-slate-200 hover:bg-slate-100 flex items-center justify-center gap-1.5 transition"
            >
              <i class="fa-solid fa-qrcode text-xs text-blue-600"></i>
              <span>QR Code</span>
            </button>

            <button 
              type="button" 
              onclick="copyToClipboard('<%= baseUrl %>/<%= site.key_name %>/')"
              class="py-2 px-3 rounded-lg text-xs font-bold bg-slate-50 text-slate-700 border border-slate-200 hover:bg-slate-100 flex items-center justify-center gap-1.5 transition"
            >
              <i class="fa-regular fa-copy text-xs text-slate-500"></i>
              <span>Copy Link</span>
            </button>
          </div>
        </div>

      </div>
    <% }) %>
  </div>

</div>

<!-- QR Modal -->
<div id="qr-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl relative text-center border border-slate-100">
    <button 
      onclick="document.getElementById('qr-modal').classList.add('hidden')"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 w-8 h-8 rounded-full flex items-center justify-center hover:bg-slate-100 transition"
    >
      <i class="fa-solid fa-xmark text-base"></i>
    </button>

    <h2 class="text-base font-bold text-slate-900 mb-1" id="qr-label">QR Code</h2>
    <p class="text-xs text-slate-500 mb-4 font-mono break-all px-2" id="qr-url-label"></p>

    <div class="flex justify-center mb-5">
      <div class="bg-white p-3 rounded-xl border border-slate-200 inline-block">
        <img id="qr-image" src="" alt="QR Code" class="w-48 h-48 block mx-auto">
      </div>
    </div>

    <a 
      id="qr-download-btn"
      href="#"
      download="qr.png"
      class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white transition shadow-sm"
    >
      <i class="fa-solid fa-download text-xs"></i>
      <span>Download High-Res QR</span>
    </a>
  </div>
</div>

<script>
  function filterPortals() {
    const q = document.getElementById('portal-search').value.toLowerCase();
    const cards = document.querySelectorAll('.portal-card');
    cards.forEach(card => {
      const name = card.querySelector('.portal-name').textContent.toLowerCase();
      card.style.display = name.includes(q) ? '' : 'none';
    });
  }

  function copyToClipboard(text) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(() => {
        showToast('Copied: ' + text);
      });
    } else {
      showToast('Copied: ' + text);
    }
  }

  function showToast(msg) {
    const toast = document.createElement('div');
    toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 bg-slate-900 text-white text-xs font-bold px-4 py-2 rounded-xl shadow-xl z-50 transition-all border border-slate-700 flex items-center gap-2';
    toast.innerHTML = '<i class="fa-solid fa-check text-emerald-400"></i> ' + msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
  }

  async function showQR(siteId, keyName, title) {
    const modal = document.getElementById('qr-modal');
    const img = document.getElementById('qr-image');
    const label = document.getElementById('qr-label');
    const urlLabel = document.getElementById('qr-url-label');
    const dlBtn = document.getElementById('qr-download-btn');

    img.src = '';
    label.textContent = title;
    urlLabel.textContent = 'Loading...';
    modal.classList.remove('hidden');

    try {
      const resp = await fetch(`/admin/sites/${siteId}/qr`);
      const data = await resp.json();
      img.src = data.qr;
      urlLabel.textContent = data.url + '{ID}';
      dlBtn.href = data.qr;
      dlBtn.download = `qr-${keyName}.png`;
    } catch(e) {
      urlLabel.textContent = 'Error loading QR';
    }
  }
</script>
