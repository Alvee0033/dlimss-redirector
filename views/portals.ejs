<div class="max-w-6xl mx-auto px-3.5 sm:px-6 py-4 sm:py-8">

  <!-- Clean Mobile & Desktop Header Banner -->
  <div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-5 sm:p-7 mb-5 sm:mb-7 shadow-lg border border-slate-800 relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 w-44 h-44 bg-blue-600/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute left-1/3 -top-10 w-40 h-40 bg-indigo-500/15 rounded-full blur-2xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-300 text-[11px] font-bold mb-2">
          <i class="fa-solid fa-shield-halved text-xs"></i>
          <span>Official Verification Hub</span>
        </div>
        <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight flex items-center gap-2.5">
          <span>Destination Portals & System Hub</span>
        </h1>
        <p class="text-slate-300 text-xs sm:text-sm mt-1 max-w-xl leading-relaxed">
          One-tap launchpad with official agency logos, direct administrator logins, and copyable credentials.
        </p>
      </div>

      <div class="flex items-center gap-2 self-start sm:self-center flex-wrap">
        <span class="text-xs font-bold px-3 py-1.5 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 shadow-xs flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span><%= sites.filter(s => s.is_active).length %> Online</span>
        </span>
        <span class="text-xs font-bold px-3 py-1.5 rounded-xl bg-white/10 text-slate-200 border border-white/15 shadow-xs flex items-center gap-1.5">
          <i class="fa-solid fa-bolt text-amber-400 text-xs"></i>
          <span><%= sites.reduce((acc, s) => acc + (s.total_clicks || 0), 0) %> Scans</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Search Filter -->
  <div class="mb-5 sm:mb-6 relative">
    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
      <i class="fa-solid fa-magnifying-glass text-sm"></i>
    </div>
    <input 
      type="text" 
      id="portal-search" 
      oninput="filterPortals()" 
      placeholder="Search by country, keyword, or URL (e.g. Bangladesh, Pakistan, DARI, India)..." 
      class="w-full rounded-2xl pl-10 pr-4 py-3 text-sm text-slate-900 bg-white border border-slate-200 shadow-xs focus:ring-2 focus:ring-blue-600 focus:border-blue-600 transition"
    >
  </div>

  <!-- Cards Grid (Mobile responsive: 1 col on mobile, 2 col on tablet, 3 col on large desktop) -->
  <div id="portals-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
    <% 
      const getMeta = (key) => {
        key = (key || '').toLowerCase();
        if (key.includes('dari')) {
          return {
            logo: '/logos/dari.svg',
            type: 'image',
            bannerBg: 'from-emerald-600 to-teal-700',
            badgeBg: 'bg-emerald-50 text-emerald-800 border-emerald-200',
            adminUrl: 'https://dari-ace.com/admin',
            user: 'officer@adrec.gov.ae',
            pass: 'admin123',
            badge: 'Abu Dhabi ADREC',
            desc: 'DARI Real Estate Contract & Document Verification'
          };
        }
        if (key.includes('bd')) {
          return {
            logo: '/logos/bd.png',
            type: 'image',
            bannerBg: 'from-emerald-700 to-green-800',
            badgeBg: 'bg-green-50 text-green-800 border-green-200',
            adminUrl: 'http://ewqqphsfrvznx2wabg1dgoej.163.227.239.97.sslip.io/login',
            user: 'admin@brta.gov.bd',
            pass: 'admin123',
            badge: 'Bangladesh BRTA',
            desc: 'BRTA Smart Driving Licence Card Portal'
          };
        }
        if (key.includes('pk')) {
          return {
            logo: '/logos/pk.png',
            type: 'image',
            bannerBg: 'from-teal-700 to-cyan-900',
            badgeBg: 'bg-teal-50 text-teal-800 border-teal-200',
            adminUrl: 'https://kpk.dlimsvr.com/admin',
            user: 'admin',
            pass: 'admin',
            badge: 'KPK Police DLIMS',
            desc: 'Khyber Pakhtunkhwa Driving Licence Verification'
          };
        }
        if (key.includes('pakistan')) {
          return {
            logo: '/logos/pakistan.png',
            type: 'image',
            bannerBg: 'from-emerald-800 to-teal-900',
            badgeBg: 'bg-emerald-50 text-emerald-800 border-emerald-200',
            adminUrl: 'https://pakistan.dlimsvr.com/admin',
            user: 'admin@dlims.gov',
            pass: 'dlims@admin2024',
            badge: 'Islamabad Police',
            desc: 'Islamabad Capital Territory DLIMS System'
          };
        }
        if (key.includes('india')) {
          return {
            logo: '/logos/india.png',
            type: 'image',
            bannerBg: 'from-amber-600 to-orange-700',
            badgeBg: 'bg-orange-50 text-orange-800 border-orange-200',
            adminUrl: 'https://sarathiparivahn.com/something',
            user: 'admin@dlims.gov',
            pass: 'dlims@admin2024',
            badge: 'Sarathi Parivahan',
            desc: 'Ministry of Road Transport & Highways DL Portal'
          };
        }
        if (key.includes('afghan')) {
          return {
            logo: '/logos/afghan.webp',
            type: 'image',
            bannerBg: 'from-rose-800 to-red-950',
            badgeBg: 'bg-red-50 text-red-800 border-red-200',
            adminUrl: 'https://afgani.dlimsvr.com/login',
            user: 'admin',
            pass: 'admin123',
            badge: 'Afghanistan Traffic',
            desc: 'Traffic Police Directorate Driving License Verification'
          };
        }
        if (key.includes('card')) {
          return {
            logo: '/logos/card.svg',
            type: 'image',
            bannerBg: 'from-indigo-600 to-violet-800',
            badgeBg: 'bg-indigo-50 text-indigo-800 border-indigo-200',
            adminUrl: 'http://c9cdcow274htjl1cb71aph7c.163.227.239.97.sslip.io',
            user: 'Public Studio',
            pass: 'No Password Required',
            badge: 'Card Studio',
            desc: '2-Page Interactive Card Generator & PDF Studio'
          };
        }
        return {
          icon: 'fa-solid fa-globe',
          type: 'icon',
          bannerBg: 'from-slate-700 to-slate-900',
          badgeBg: 'bg-slate-50 text-slate-800 border-slate-200',
          adminUrl: '',
          user: 'admin',
          pass: 'admin123',
          badge: 'External Portal',
          desc: 'External Verification Portal'
        };
      };
    %>

    <% sites.forEach(site => { 
      const meta = getMeta(site.key_name);
    %>
      <div class="portal-card bg-white border border-slate-200/90 rounded-3xl shadow-sm hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between overflow-hidden">
        
        <!-- Card Top Section -->
        <div>
          <!-- Mini Country / Agency Top Banner -->
          <div class="h-16 bg-gradient-to-r <%= meta.bannerBg %> px-4 pt-3 flex items-start justify-between relative">
            <div class="flex items-center gap-1.5">
              <span class="font-mono text-[11px] font-black text-white/95 bg-black/25 backdrop-blur-xs px-2.5 py-0.5 rounded-lg border border-white/20">
                /<%= site.key_name %>
              </span>
            </div>
            
            <span class="text-[10px] font-extrabold text-white bg-white/20 backdrop-blur-xs px-2.5 py-0.5 rounded-full border border-white/25">
              <%= meta.badge %>
            </span>
          </div>

          <!-- Logo & Header Overlay -->
          <div class="px-4.5 -mt-8 flex items-end gap-3 mb-3">
            <!-- Constrained Logo Box (Clean, never clipped, never overflow) -->
            <div class="w-16 h-16 min-w-16 min-h-16 max-w-16 max-h-16 rounded-2xl p-2 bg-white border-2 border-slate-100 shadow-md flex items-center justify-center flex-shrink-0 z-10 overflow-hidden">
              <% if (meta.type === 'image') { %>
                <img src="<%= meta.logo %>" alt="<%= site.title %> logo" class="w-full h-full max-w-full max-h-full object-contain block">
              <% } else { %>
                <i class="<%= meta.icon %> text-2xl text-slate-600"></i>
              <% } %>
            </div>

            <div class="flex-1 min-w-0 pb-1">
              <h2 class="portal-name font-black text-base text-slate-900 leading-snug line-clamp-1" title="<%= site.title %>">
                <%= site.title %>
              </h2>
              <p class="text-[11px] text-slate-500 font-medium truncate">
                <%= meta.desc %>
              </p>
            </div>
          </div>

          <div class="px-4.5 space-y-2.5">
            <!-- Destination URL Box -->
            <div class="bg-slate-50 border border-slate-100 rounded-xl p-2.5 flex items-center justify-between gap-2">
              <span class="text-[11px] font-mono text-slate-600 truncate flex-1" title="<%= site.base_url %>">
                <%= site.base_url %>
              </span>
              <span class="text-[10px] font-bold text-slate-500 bg-white border border-slate-200/80 px-2 py-0.5 rounded-md flex-shrink-0 shadow-2xs">
                <%= site.total_clicks || 0 %> scans
              </span>
            </div>

            <!-- Credentials Box with Quick-Copy -->
            <div class="bg-amber-50/50 border border-amber-200/70 rounded-2xl p-3 space-y-1.5">
              <div class="text-[10px] font-black uppercase tracking-wider text-amber-900 flex items-center justify-between">
                <span class="flex items-center gap-1.5">
                  <i class="fa-solid fa-key text-[10px] text-amber-600"></i>
                  <span>Admin Credentials</span>
                </span>
                <% if (meta.adminUrl) { %>
                  <a href="<%= meta.adminUrl %>" target="_blank" class="text-[10px] font-bold text-blue-700 hover:text-blue-800 hover:underline flex items-center gap-1">
                    <span>Direct Login</span>
                    <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
                  </a>
                <% } %>
              </div>

              <!-- Username row -->
              <div class="flex items-center justify-between bg-white border border-amber-100 rounded-xl px-2.5 py-1.5 text-xs">
                <span class="text-slate-400 text-[11px] font-bold">User:</span>
                <div class="flex items-center gap-1.5 max-w-[75%]">
                  <code class="font-mono text-[11px] font-black text-slate-800 truncate"><%= meta.user %></code>
                  <% if (meta.user !== 'Public Studio') { %>
                    <button type="button" onclick="copyToClipboard('<%= meta.user %>')" class="text-slate-400 hover:text-blue-600 p-1 rounded-md hover:bg-slate-50" title="Copy Username">
                      <i class="fa-regular fa-copy text-xs"></i>
                    </button>
                  <% } %>
                </div>
              </div>

              <!-- Password row -->
              <div class="flex items-center justify-between bg-white border border-amber-100 rounded-xl px-2.5 py-1.5 text-xs">
                <span class="text-slate-400 text-[11px] font-bold">Pass:</span>
                <div class="flex items-center gap-1.5 max-w-[75%]">
                  <code class="font-mono text-[11px] font-black text-slate-800 truncate"><%= meta.pass %></code>
                  <% if (meta.pass !== 'No Password Required') { %>
                    <button type="button" onclick="copyToClipboard('<%= meta.pass %>')" class="text-slate-400 hover:text-blue-600 p-1 rounded-md hover:bg-slate-50" title="Copy Password">
                      <i class="fa-regular fa-copy text-xs"></i>
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="p-4.5 pt-3 space-y-2 border-t border-slate-100 mt-3">
          <a 
            href="<%= meta.adminUrl || site.base_url %>" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full py-2.5 px-3 rounded-xl text-xs font-black bg-blue-600 hover:bg-blue-700 text-white flex items-center justify-center gap-2 transition shadow-xs active:scale-[0.99]"
          >
            <span>Launch Dashboard</span>
            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
          </a>

          <div class="grid grid-cols-2 gap-2">
            <button 
              type="button" 
              onclick="showQR(<%= site.id %>, '<%= site.key_name %>', '<%= site.title %>')"
              class="py-2.5 px-3 rounded-xl text-xs font-bold bg-slate-50 text-slate-700 border border-slate-200 hover:bg-slate-100 hover:text-slate-900 flex items-center justify-center gap-1.5 transition active:scale-[0.98]"
            >
              <i class="fa-solid fa-qrcode text-xs text-blue-600"></i>
              <span>QR Code</span>
            </button>

            <button 
              type="button" 
              onclick="copyToClipboard('<%= baseUrl %>/<%= site.key_name %>/')"
              class="py-2.5 px-3 rounded-xl text-xs font-bold bg-slate-50 text-slate-700 border border-slate-200 hover:bg-slate-100 hover:text-slate-900 flex items-center justify-center gap-1.5 transition active:scale-[0.98]"
            >
              <i class="fa-regular fa-copy text-xs text-slate-500"></i>
              <span>Copy Link</span>
            </button>
          </div>
        </div>

      </div>
    <% }) %>
  </div>

</div>

<!-- QR Modal -->
<div id="qr-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl relative text-center border border-slate-100 animate-in fade-in zoom-in-95 duration-150">
    <button 
      onclick="document.getElementById('qr-modal').classList.add('hidden')"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 w-8 h-8 rounded-full flex items-center justify-center hover:bg-slate-100 transition"
    >
      <i class="fa-solid fa-xmark text-base"></i>
    </button>

    <h2 class="text-base font-black text-slate-900 mb-1" id="qr-label">QR Code</h2>
    <p class="text-xs text-slate-500 mb-4 font-mono break-all px-2" id="qr-url-label"></p>

    <div class="flex justify-center mb-5">
      <div class="bg-white p-3.5 rounded-2xl border-2 border-slate-100 shadow-inner inline-block">
        <img id="qr-image" src="" alt="QR Code" class="w-48 h-48 block mx-auto rounded-lg">
      </div>
    </div>

    <a 
      id="qr-download-btn"
      href="#"
      download="qr.png"
      class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white transition shadow-sm"
    >
      <i class="fa-solid fa-download text-xs"></i>
      <span>Download High-Res QR</span>
    </a>
  </div>
</div>

<script>
  function filterPortals() {
    const q = document.getElementById('portal-search').value.toLowerCase();
    const cards = document.querySelectorAll('.portal-card');
    cards.forEach(card => {
      const name = card.querySelector('.portal-name').textContent.toLowerCase();
      card.style.display = name.includes(q) ? '' : 'none';
    });
  }

  function copyToClipboard(text) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(() => {
        showToast('Copied: ' + text);
      });
    } else {
      showToast('Copied: ' + text);
    }
  }

  function showToast(msg) {
    const toast = document.createElement('div');
    toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 bg-slate-900 text-white text-xs font-bold px-4 py-2 rounded-xl shadow-2xl z-50 transition-all border border-slate-700 flex items-center gap-2';
    toast.innerHTML = '<i class="fa-solid fa-check text-emerald-400"></i> ' + msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
  }

  async function showQR(siteId, keyName, title) {
    const modal = document.getElementById('qr-modal');
    const img = document.getElementById('qr-image');
    const label = document.getElementById('qr-label');
    const urlLabel = document.getElementById('qr-url-label');
    const dlBtn = document.getElementById('qr-download-btn');

    img.src = '';
    label.textContent = title;
    urlLabel.textContent = 'Loading...';
    modal.classList.remove('hidden');

    try {
      const resp = await fetch(`/admin/sites/${siteId}/qr`);
      const data = await resp.json();
      img.src = data.qr;
      urlLabel.textContent = data.url + '{ID}';
      dlBtn.href = data.qr;
      dlBtn.download = `qr-${keyName}.png`;
    } catch(e) {
      urlLabel.textContent = 'Error loading QR';
    }
  }
</script>
