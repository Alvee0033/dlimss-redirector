<div class="max-w-6xl mx-auto px-4 sm:px-6 py-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Sites Links</h1>
      <p class="text-slate-600 text-sm mt-1">
        Direct 1-click links to open verification portals and scan QR codes.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <span class="px-4 py-2 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded-xl text-sm font-bold flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
        <span><%= sites.filter(s => s.is_active).length %> Online</span>
      </span>
      <span class="px-4 py-2 bg-blue-50 text-blue-800 border border-blue-200 rounded-xl text-sm font-bold">
        <%= sites.reduce((acc, s) => acc + (s.total_clicks || 0), 0) %> Total Clicks
      </span>
    </div>
  </div>

  <!-- Search Filter -->
  <div class="mb-6 relative">
    <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-slate-400">
      <i class="fa-solid fa-magnifying-glass"></i>
    </div>
    <input 
      type="text" 
      id="portal-search" 
      oninput="filterPortals()" 
      placeholder="Search sites links..." 
      class="w-full rounded-xl pl-11 pr-4 py-3.5 text-base text-slate-900 shadow-sm"
    >
  </div>

  <!-- Big Site Link Cards -->
  <div id="portals-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% sites.forEach(site => { %>
      <div class="portal-card bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:shadow-md transition flex flex-col justify-between">
        
        <div>
          <!-- Top Row -->
          <div class="flex items-start justify-between gap-2 mb-2">
            <div>
              <h2 class="portal-name text-xl font-extrabold text-slate-900"><%= site.title %></h2>
              <span class="portal-key font-mono text-sm font-bold text-blue-600 bg-blue-50 border border-blue-200 px-2.5 py-0.5 rounded-md inline-block mt-1">
                /<%= site.key_name %>
              </span>
            </div>
            
            <span class="text-xs font-bold px-2.5 py-1 rounded-full <%= site.is_active ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-200 text-slate-600' %>">
              <%= site.is_active ? 'Active' : 'Off' %>
            </span>
          </div>

          <!-- Target Base URL Box -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 my-3">
            <span class="text-xs font-bold text-slate-500 uppercase block mb-0.5">Target Destination URL</span>
            <div class="font-mono text-sm text-slate-800 truncate" title="<%= site.base_url %>">
              <%= site.base_url %>
            </div>
          </div>
        </div>

        <!-- Buttons -->
        <div class="space-y-2 pt-2 border-t border-slate-100">
          <!-- 1-Click Open Portal -->
          <a 
            href="<%= site.base_url %>" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full py-3 px-4 rounded-xl text-base font-bold bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center gap-2 transition shadow-sm"
          >
            <span>Open Site Directly</span>
            <i class="fa-solid fa-arrow-up-right-from-square text-sm"></i>
          </a>

          <div class="grid grid-cols-3 gap-2">
            <a 
              href="/<%= site.key_name %>/SAMPLE-12345" 
              target="_blank" 
              class="py-2.5 px-3 rounded-xl text-sm font-bold bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100 flex items-center justify-center gap-1.5 transition text-center"
            >
              <i class="fa-solid fa-bolt text-xs"></i>
              <span>Test</span>
            </a>

            <button 
              type="button" 
              onclick="showQR(<%= site.id %>, '<%= site.key_name %>', '<%= site.title %>')"
              class="py-2.5 px-3 rounded-xl text-sm font-bold bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 flex items-center justify-center gap-1.5 transition"
            >
              <i class="fa-solid fa-qrcode text-xs"></i>
              <span>QR Code</span>
            </button>

            <button 
              type="button" 
              onclick="copyToClipboard('<%= baseUrl %>/<%= site.key_name %>/')"
              class="py-2.5 px-3 rounded-xl text-sm font-bold bg-slate-100 text-slate-700 border border-slate-200 hover:bg-slate-200 flex items-center justify-center gap-1.5 transition"
            >
              <i class="fa-regular fa-copy text-xs"></i>
              <span>Copy</span>
            </button>
          </div>
        </div>

      </div>
    <% }) %>
  </div>

</div>

<!-- QR Modal -->
<div id="qr-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white border border-slate-200 rounded-2xl max-w-sm w-full p-6 shadow-2xl relative text-center">
    <button 
      onclick="document.getElementById('qr-modal').classList.add('hidden')"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-2"
    >
      <i class="fa-solid fa-xmark text-xl"></i>
    </button>

    <h2 class="text-xl font-bold text-slate-900 mb-1" id="qr-label">QR Code</h2>
    <p class="text-xs text-slate-500 mb-4 font-mono break-all" id="qr-url-label"></p>

    <div class="flex justify-center mb-4">
      <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 inline-block">
        <img id="qr-image" src="" alt="QR Code" class="w-56 h-56 block mx-auto">
      </div>
    </div>

    <a 
      id="qr-download-btn"
      href="#"
      download="qr.png"
      class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-base font-bold bg-blue-600 hover:bg-blue-700 text-white transition shadow"
    >
      <i class="fa-solid fa-download text-sm"></i>
      Download QR PNG
    </a>
  </div>
</div>

<script>
  function filterPortals() {
    const q = document.getElementById('portal-search').value.toLowerCase();
    const cards = document.querySelectorAll('.portal-card');
    cards.forEach(card => {
      const name = card.querySelector('.portal-name').textContent.toLowerCase();
      const key = card.querySelector('.portal-key').textContent.toLowerCase();
      card.style.display = (name.includes(q) || key.includes(q)) ? '' : 'none';
    });
  }

  function copyToClipboard(text) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(() => {
        showToast('Copied: ' + text);
      });
    } else {
      showToast('Copied: ' + text);
    }
  }

  function showToast(msg) {
    const toast = document.createElement('div');
    toast.className = 'fixed bottom-24 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-sm font-semibold px-4 py-2 rounded-xl shadow-xl z-50';
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
  }

  async function showQR(siteId, keyName, title) {
    const modal = document.getElementById('qr-modal');
    const img = document.getElementById('qr-image');
    const label = document.getElementById('qr-label');
    const urlLabel = document.getElementById('qr-url-label');
    const dlBtn = document.getElementById('qr-download-btn');

    img.src = '';
    label.textContent = title;
    urlLabel.textContent = 'Generating...';
    modal.classList.remove('hidden');

    try {
      const resp = await fetch(`/admin/sites/${siteId}/qr`);
      const data = await resp.json();
      img.src = data.qr;
      urlLabel.textContent = data.url + '{ID}';
      dlBtn.href = data.qr;
      dlBtn.download = `qr-${keyName}.png`;
    } catch(e) {
      urlLabel.textContent = 'Error generating QR';
    }
  }
</script>
