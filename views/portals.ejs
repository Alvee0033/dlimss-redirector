<div class="max-w-5xl mx-auto px-4 py-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">Destination Websites</h1>
      <p class="text-slate-500 text-sm mt-0.5">
        Open websites directly in your browser or download their QR codes.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-xs font-bold px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200">
        <%= sites.filter(s => s.is_active).length %> Online
      </span>
      <span class="text-xs font-bold px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 border border-slate-200">
        <%= sites.reduce((acc, s) => acc + (s.total_clicks || 0), 0) %> Scans
      </span>
    </div>
  </div>

  <!-- Search Filter -->
  <div class="mb-5 relative">
    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
      <i class="fa-solid fa-magnifying-glass text-sm"></i>
    </div>
    <input 
      type="text" 
      id="portal-search" 
      oninput="filterPortals()" 
      placeholder="Search websites..." 
      class="w-full rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-900 shadow-sm"
    >
  </div>

  <!-- Cards -->
  <div id="portals-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% sites.forEach(site => { %>
      <div class="portal-card bg-white border border-slate-200 rounded-2xl p-5 shadow-sm hover:border-slate-300 transition flex flex-col justify-between">
        
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <h2 class="portal-name font-extrabold text-base sm:text-lg text-slate-900"><%= site.title %></h2>
            <span class="portal-key font-mono text-xs font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-md">
              /<%= site.key_name %>
            </span>
          </div>

          <div class="bg-slate-50 border border-slate-100 rounded-xl p-3 my-2 text-xs font-mono text-slate-700 truncate" title="<%= site.base_url %>">
            <%= site.base_url %>
          </div>
        </div>

        <div class="space-y-2 pt-3 border-t border-slate-100">
          <a 
            href="<%= site.base_url %>" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full py-2.5 px-4 rounded-xl text-sm font-bold bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center gap-2 transition shadow-sm"
          >
            <span>Open Website</span>
            <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
          </a>

          <div class="grid grid-cols-2 gap-2">
            <button 
              type="button" 
              onclick="showQR(<%= site.id %>, '<%= site.key_name %>', '<%= site.title %>')"
              class="py-2 px-3 rounded-lg text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200 hover:bg-blue-100 flex items-center justify-center gap-1.5 transition"
            >
              <i class="fa-solid fa-qrcode text-xs"></i>
              <span>QR Code</span>
            </button>

            <button 
              type="button" 
              onclick="copyToClipboard('<%= baseUrl %>/<%= site.key_name %>/')"
              class="py-2 px-3 rounded-lg text-xs font-bold bg-slate-50 text-slate-700 border border-slate-200 hover:bg-slate-100 flex items-center justify-center gap-1.5 transition"
            >
              <i class="fa-regular fa-copy text-xs"></i>
              <span>Copy Link</span>
            </button>
          </div>
        </div>

      </div>
    <% }) %>
  </div>

</div>

<!-- QR Modal -->
<div id="qr-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl relative text-center">
    <button 
      onclick="document.getElementById('qr-modal').classList.add('hidden')"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-2"
    >
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>

    <h2 class="text-base font-bold text-slate-900 mb-1" id="qr-label">QR Code</h2>
    <p class="text-xs text-slate-500 mb-4 font-mono break-all" id="qr-url-label"></p>

    <div class="flex justify-center mb-4">
      <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 inline-block">
        <img id="qr-image" src="" alt="QR Code" class="w-48 h-48 block mx-auto">
      </div>
    </div>

    <a 
      id="qr-download-btn"
      href="#"
      download="qr.png"
      class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white transition shadow-sm"
    >
      <i class="fa-solid fa-download text-xs"></i>
      Download Image
    </a>
  </div>
</div>

<script>
  function filterPortals() {
    const q = document.getElementById('portal-search').value.toLowerCase();
    const cards = document.querySelectorAll('.portal-card');
    cards.forEach(card => {
      const name = card.querySelector('.portal-name').textContent.toLowerCase();
      const key = card.querySelector('.portal-key').textContent.toLowerCase();
      card.style.display = (name.includes(q) || key.includes(q)) ? '' : 'none';
    });
  }

  function copyToClipboard(text) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(() => {
        showToast('Link copied');
      });
    } else {
      showToast('Link copied');
    }
  }

  function showToast(msg) {
    const toast = document.createElement('div');
    toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-xs font-semibold px-3 py-1.5 rounded-lg shadow-lg z-50';
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2000);
  }

  async function showQR(siteId, keyName, title) {
    const modal = document.getElementById('qr-modal');
    const img = document.getElementById('qr-image');
    const label = document.getElementById('qr-label');
    const urlLabel = document.getElementById('qr-url-label');
    const dlBtn = document.getElementById('qr-download-btn');

    img.src = '';
    label.textContent = title;
    urlLabel.textContent = 'Loading...';
    modal.classList.remove('hidden');

    try {
      const resp = await fetch(`/admin/sites/${siteId}/qr`);
      const data = await resp.json();
      img.src = data.qr;
      urlLabel.textContent = data.url + '{ID}';
      dlBtn.href = data.qr;
      dlBtn.download = `qr-${keyName}.png`;
    } catch(e) {
      urlLabel.textContent = 'Error';
    }
  }
</script>
