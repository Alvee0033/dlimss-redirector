<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

  <!-- Header Banner -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
    <div>
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs font-semibold mb-2">
        <i class="fa-solid fa-satellite-dish"></i>
        <span>Direct Portal Launchpad</span>
      </div>
      <h1 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Active Destination Portals</h1>
      <p class="text-slate-400 text-xs sm:text-sm mt-0.5">
        Click any portal below to navigate to the live verification application or run an automated test redirect.
      </p>
    </div>

    <!-- Quick Stats Badge -->
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <span class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold text-slate-300 flex items-center gap-2 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span><%= sites.filter(s => s.is_active).length %> Online</span>
      </span>
      <span class="px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold text-indigo-300">
        <%= sites.reduce((acc, s) => acc + (s.total_clicks || 0), 0) %> Total Scans
      </span>
    </div>
  </div>

  <!-- Search / Filter Input (Mobile Friendly) -->
  <div class="mb-6 relative">
    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
      <i class="fa-solid fa-magnifying-glass text-xs"></i>
    </div>
    <input 
      type="text" 
      id="portal-search" 
      oninput="filterPortals()" 
      placeholder="Search portal by name, country, or slug..." 
      class="w-full bg-slate-900/90 border border-slate-800 rounded-xl pl-10 pr-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
    >
  </div>

  <!-- Portals Card Grid (Mobile-first 1-column, tablet 2-column, desktop 3-column) -->
  <div id="portals-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% sites.forEach(site => { %>
      <div class="portal-card bg-slate-900 border border-slate-800 hover:border-slate-700/80 rounded-2xl p-4 sm:p-5 flex flex-col justify-between transition-all duration-200 shadow-lg relative overflow-hidden group">
        
        <!-- Top Accent Bar -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-indigo-500 via-purple-500 to-emerald-400"></div>

        <div>
          <!-- Title & Badges -->
          <div class="flex items-start justify-between gap-2 mb-3 pt-1">
            <div class="flex-1 min-w-0">
              <span class="portal-name font-bold text-white text-base block truncate group-hover:text-indigo-300 transition">
                <%= site.title %>
              </span>
              <div class="flex items-center gap-1.5 mt-1">
                <span class="portal-key inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-mono font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
                  /<%= site.key_name %>
                </span>
                <span class="text-[10px] text-slate-500 font-mono">
                  <%= site.append_mode === 'query' ? `?${site.query_param_name}=ID` : `/${site.key_name}/ID` %>
                </span>
              </div>
            </div>

            <!-- Active / Clicks Badge -->
            <div class="flex flex-col items-end gap-1">
              <% if (site.is_active) { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  Active
                </span>
              <% } else { %>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-500/10 text-rose-400 border border-rose-500/20">
                  Paused
                </span>
              <% } %>
              <span class="text-[10px] text-slate-400 font-semibold flex items-center gap-1">
                <i class="fa-solid fa-chart-simple text-[9px] text-slate-500"></i>
                <%= site.total_clicks %> hits
              </span>
            </div>
          </div>

          <!-- Destination URL Preview -->
          <div class="bg-slate-950/80 rounded-xl p-2.5 border border-slate-800/80 mb-4">
            <span class="text-[10px] text-slate-500 uppercase tracking-wider font-semibold block mb-0.5">Live Target Base URL</span>
            <div class="font-mono text-xs text-slate-300 truncate" title="<%= site.base_url %>">
              <%= site.base_url %>
            </div>
          </div>
        </div>

        <!-- Action Buttons (Touch-friendly 44px height) -->
        <div class="space-y-2 pt-2 border-t border-slate-800/60">
          
          <!-- Primary 1-Click Launch Button -->
          <a 
            href="<%= site.base_url %>" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full py-2.5 px-3 rounded-xl text-xs font-bold bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white flex items-center justify-center gap-2 shadow-md shadow-emerald-900/30 transition active:scale-[0.98]"
          >
            <span>Directly Open Portal</span>
            <i class="fa-solid fa-arrow-up-right-from-square text-[11px]"></i>
          </a>

          <!-- Secondary Action Row -->
          <div class="grid grid-cols-3 gap-2">
            
            <!-- Test Redirect Route -->
            <a 
              href="/<%= site.key_name %>/SAMPLE-12345" 
              target="_blank" 
              class="py-2 px-2 rounded-xl text-[11px] font-semibold bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/30 flex items-center justify-center gap-1.5 transition text-center"
              title="Test dynamic redirect through gateway"
            >
              <i class="fa-solid fa-bolt text-[10px]"></i>
              <span>Test Route</span>
            </a>

            <!-- Generate QR Button -->
            <button 
              type="button" 
              onclick="showQR(<%= site.id %>, '<%= site.key_name %>', '<%= site.title %>')"
              class="py-2 px-2 rounded-xl text-[11px] font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700/60 flex items-center justify-center gap-1.5 transition"
              title="Generate QR code"
            >
              <i class="fa-solid fa-qrcode text-[10px] text-indigo-400"></i>
              <span>QR Code</span>
            </button>

            <!-- Copy Short Prefix -->
            <button 
              type="button" 
              onclick="copyToClipboard('<%= baseUrl %>/<%= site.key_name %>/')"
              class="py-2 px-2 rounded-xl text-[11px] font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700/60 flex items-center justify-center gap-1.5 transition"
              title="Copy redirector URL prefix"
            >
              <i class="fa-regular fa-copy text-[10px] text-emerald-400"></i>
              <span>Copy</span>
            </button>
          </div>
        </div>

      </div>
    <% }) %>
  </div>

  <% if (sites.length === 0) { %>
    <div class="text-center py-12 bg-slate-900 border border-slate-800 rounded-2xl p-6">
      <i class="fa-solid fa-layer-group text-slate-600 text-3xl mb-2"></i>
      <p class="text-sm text-slate-400 font-semibold">No portals configured yet</p>
      <a href="/admin" class="mt-3 inline-block px-4 py-2 bg-indigo-600 text-white text-xs font-semibold rounded-xl">Add your first portal</a>
    </div>
  <% } %>

</div>

<!-- QR Modal -->
<div id="qr-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-sm w-full p-6 shadow-2xl relative text-center">
    <button 
      onclick="document.getElementById('qr-modal').classList.add('hidden')"
      class="absolute top-4 right-4 text-slate-400 hover:text-white p-2 rounded-lg"
    >
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>

    <div class="p-3 bg-indigo-500/10 border border-indigo-500/20 rounded-xl text-indigo-400 text-2xl w-fit mx-auto mb-3">
      <i class="fa-solid fa-qrcode"></i>
    </div>
    <h2 class="text-base font-bold text-white mb-1" id="qr-label">QR Code</h2>
    <p class="text-[11px] text-slate-400 mb-4 font-mono break-all px-2" id="qr-url-label"></p>

    <div class="flex justify-center mb-4">
      <div class="bg-white p-3 rounded-xl inline-block shadow-inner">
        <img id="qr-image" src="" alt="QR Code" class="w-52 h-52 block mx-auto">
      </div>
    </div>

    <p class="text-[11px] text-slate-400 mb-4">
      Scan with mobile camera to test the full redirection flow to the live portal.
    </p>

    <a 
      id="qr-download-btn"
      href="#"
      download="qr.png"
      class="w-full inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-lg shadow-indigo-600/30 active:scale-95"
    >
      <i class="fa-solid fa-download text-xs"></i>
      Download QR PNG
    </a>
  </div>
</div>

<script>
  function filterPortals() {
    const q = document.getElementById('portal-search').value.toLowerCase();
    const cards = document.querySelectorAll('.portal-card');
    cards.forEach(card => {
      const name = card.querySelector('.portal-name').textContent.toLowerCase();
      const key = card.querySelector('.portal-key').textContent.toLowerCase();
      if (name.includes(q) || key.includes(q)) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function copyToClipboard(text) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(() => {
        showToast('Copied prefix: ' + text);
      });
    } else {
      showToast('Copied: ' + text);
    }
  }

  function showToast(msg) {
    const toast = document.createElement('div');
    toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 bg-slate-800 text-white border border-slate-700 text-xs px-4 py-2 rounded-xl shadow-2xl z-50 transition-all';
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
  }

  async function showQR(siteId, keyName, title) {
    const modal = document.getElementById('qr-modal');
    const img = document.getElementById('qr-image');
    const label = document.getElementById('qr-label');
    const urlLabel = document.getElementById('qr-url-label');
    const dlBtn = document.getElementById('qr-download-btn');

    img.src = '';
    label.textContent = title;
    urlLabel.textContent = 'Generating...';
    modal.classList.remove('hidden');

    try {
      const resp = await fetch(`/admin/sites/${siteId}/qr`);
      const data = await resp.json();
      img.src = data.qr;
      urlLabel.textContent = data.url + '{ID}';
      dlBtn.href = data.qr;
      dlBtn.download = `qr-${keyName}.png`;
    } catch(e) {
      urlLabel.textContent = 'Error generating QR';
    }
  }
</script>
