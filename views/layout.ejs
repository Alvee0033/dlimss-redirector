<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title><%= typeof title !== 'undefined' ? title : 'MultiVerify' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    /* Clean, high-clarity Lite / Big UI base */
    html {
      font-size: 16px;
    }
    body {
      background-color: #f1f5f9;
      color: #0f172a;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    /* Big connected bottom dock */
    .big-dock-container {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 50;
      background: #ffffff;
      border-top: 2px solid #cbd5e1;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    }

    .dock-nav-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 0.75rem 0.5rem;
      font-size: 0.95rem;
      font-weight: 700;
      color: #64748b;
      transition: all 0.15s ease;
      text-decoration: none;
      border-bottom: 4px solid transparent;
    }

    .dock-nav-item:hover {
      color: #2563eb;
      background: #f8fafc;
    }

    .dock-nav-item.active {
      color: #2563eb;
      background: #eff6ff;
      border-bottom-color: #2563eb;
    }

    .dock-nav-item i {
      font-size: 1.35rem;
      margin-bottom: 0.25rem;
    }

    /* Common clean inputs and buttons */
    input, select, textarea {
      background-color: #ffffff !important;
      border: 1.5px solid #cbd5e1 !important;
      color: #0f172a !important;
      font-size: 1rem !important;
    }
    input:focus, select:focus, textarea:focus {
      border-color: #2563eb !important;
      outline: none;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
    }

    button, a {
      touch-action: manipulation;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col pb-28">

  <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
  <!-- Clean Big Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-18 flex items-center justify-between py-3">
      
      <!-- Brand -->
      <a href="/admin" class="flex items-center gap-3">
        <div class="bg-blue-600 text-white p-2.5 rounded-xl text-xl flex items-center justify-center shadow-sm">
          <i class="fa-solid fa-qrcode"></i>
        </div>
        <div>
          <span class="font-extrabold text-xl text-slate-900 tracking-tight">MultiVerify</span>
          <p class="text-xs text-slate-500 font-medium">QR Redirector</p>
        </div>
      </a>

      <!-- Quick Actions -->
      <div class="flex items-center gap-3">
        <a href="/admin/logout" class="px-4 py-2 bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200 rounded-xl text-sm font-bold flex items-center gap-2 transition">
          <i class="fa-solid fa-arrow-right-from-bracket"></i>
          <span>Logout</span>
        </a>
      </div>

    </div>
  </header>

  <!-- Big Connected Bottom Dock -->
  <nav class="big-dock-container">
    <div class="max-w-4xl mx-auto grid grid-cols-4">
      
      <a href="/admin" class="dock-nav-item <%= (typeof activeTab !== 'undefined' && activeTab === 'sites') ? 'active' : '' %>">
        <i class="fa-solid fa-house"></i>
        <span>Overview</span>
      </a>

      <a href="/admin/rules" class="dock-nav-item <%= (typeof activeTab !== 'undefined' && activeTab === 'rules') ? 'active' : '' %>">
        <i class="fa-solid fa-sliders"></i>
        <span>Site Rules</span>
      </a>

      <a href="/admin/portals" class="dock-nav-item <%= (typeof activeTab !== 'undefined' && activeTab === 'portals') ? 'active' : '' %>">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        <span>Sites Links</span>
      </a>

      <a href="/admin/logs" class="dock-nav-item <%= (typeof activeTab !== 'undefined' && activeTab === 'logs') ? 'active' : '' %>">
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span>Logs</span>
      </a>

    </div>
  </nav>
  <% } %>

  <!-- Main Content View -->
  <main class="flex-grow">
    <%- body %>
  </main>

</body>
</html>
