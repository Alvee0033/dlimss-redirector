<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? title : 'QR Manager' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    body {
      background-color: #f8fafc;
      color: #0f172a;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    /* Fixed bottom dock designed for mobile and desktop */
    .mobile-dock {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 50;
      background: #ffffff;
      border-top: 1px solid #e2e8f0;
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.06);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    .dock-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      max-width: 600px;
      margin: 0 auto;
      height: 64px;
    }

    .dock-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      color: #64748b;
      font-weight: 700;
      font-size: 0.78rem;
      text-decoration: none;
      transition: all 0.15s ease;
      touch-action: manipulation;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .dock-btn i {
      font-size: 1.25rem;
      transition: transform 0.15s ease;
    }

    .dock-btn:active i {
      transform: scale(0.9);
    }

    .dock-btn.active {
      color: #2563eb;
    }

    .dock-btn.active i {
      color: #2563eb;
    }

    @media (min-width: 640px) {
      .mobile-dock {
        bottom: 1rem;
        left: 50%;
        right: auto;
        transform: translateX(-50%);
        border: 1px solid #cbd5e1;
        border-radius: 9999px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12);
        padding: 0.25rem 0.5rem;
        width: auto;
      }
      .dock-grid {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        height: auto;
      }
      .dock-btn {
        flex-direction: row;
        gap: 0.5rem;
        padding: 0.6rem 1.1rem;
        border-radius: 9999px;
        font-size: 0.88rem;
      }
      .dock-btn i {
        font-size: 1rem;
      }
      .dock-btn.active {
        background: #2563eb;
        color: #ffffff;
      }
      .dock-btn.active i {
        color: #ffffff;
      }
    }

    input, select {
      background-color: #ffffff !important;
      border: 1px solid #cbd5e1 !important;
      color: #0f172a !important;
    }
    input:focus, select:focus {
      border-color: #2563eb !important;
      outline: none;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col pb-24 sm:pb-28">

  <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
  <!-- Clean Header -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
    <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
      
      <a href="/admin" class="flex items-center gap-2.5">
        <div class="bg-blue-600 text-white w-9 h-9 rounded-xl flex items-center justify-center font-bold text-lg shadow-sm">
          <i class="fa-solid fa-qrcode"></i>
        </div>
        <span class="font-extrabold text-lg text-slate-900 tracking-tight">QR Manager</span>
      </a>

      <a href="/admin/logout" class="text-xs font-bold px-3 py-1.5 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50 transition flex items-center gap-1.5">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
        <span>Logout</span>
      </a>

    </div>
  </header>

  <!-- Proper Mobile & Desktop Dock Navigation -->
  <nav class="mobile-dock">
    <div class="dock-grid">
      <a href="/admin" class="dock-btn <%= (typeof activeTab !== 'undefined' && activeTab === 'sites') ? 'active' : '' %>">
        <i class="fa-solid fa-house"></i>
        <span>Home</span>
      </a>

      <a href="/admin/rules" class="dock-btn <%= (typeof activeTab !== 'undefined' && activeTab === 'rules') ? 'active' : '' %>">
        <i class="fa-solid fa-route"></i>
        <span>QR Links</span>
      </a>

      <a href="/admin/portals" class="dock-btn <%= (typeof activeTab !== 'undefined' && activeTab === 'portals') ? 'active' : '' %>">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        <span>Websites</span>
      </a>

      <a href="/admin/logs" class="dock-btn <%= (typeof activeTab !== 'undefined' && activeTab === 'logs') ? 'active' : '' %>">
        <i class="fa-solid fa-clock-rotate-left"></i>
        <span>History</span>
      </a>
    </div>
  </nav>
  <% } %>

  <!-- Main Content -->
  <main class="flex-grow">
    <%- body %>
  </main>

</body>
</html>
