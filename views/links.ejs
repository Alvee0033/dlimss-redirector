<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/20 text-xs font-semibold mb-2">
        <i class="fa-solid fa-link"></i>
        <span>Direct Shortlinks</span>
      </div>
      <h1 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Custom Slugs Manager</h1>
      <p class="text-slate-400 text-xs sm:text-sm mt-0.5">
        Create clean custom aliases that route directly to target URLs with optional query forwarding.
      </p>
    </div>

    <button 
      onclick="document.getElementById('new-link-modal').classList.remove('hidden')"
      class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition shadow-lg shadow-indigo-600/30 flex items-center gap-2 self-start sm:self-auto"
    >
      <i class="fa-solid fa-plus text-xs"></i>
      <span>Add Custom Slug</span>
    </button>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="mb-4 p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs sm:text-sm flex items-center gap-2.5">
      <i class="fa-solid fa-circle-check text-sm flex-shrink-0"></i>
      <span><%= success %></span>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-4 p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs sm:text-sm flex items-center gap-2.5">
      <i class="fa-solid fa-triangle-exclamation text-sm flex-shrink-0"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Mobile View: Cards (< md) -->
  <div class="block md:hidden space-y-3 mb-8">
    <% if (links.length === 0) { %>
      <div class="text-center py-10 bg-slate-900 border border-slate-800 rounded-2xl p-4 text-slate-500 text-xs">
        No custom slugs created yet.
      </div>
    <% } %>

    <% links.forEach(link => { %>
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-md space-y-3">
        <div class="flex items-start justify-between gap-2">
          <div class="flex-1 min-w-0">
            <h3 class="font-bold text-white text-sm truncate"><%= link.title || 'Untitled Link' %></h3>
            <span class="font-mono text-xs text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded border border-purple-500/20 mt-1 inline-block">
              /<%= link.slug %>
            </span>
          </div>

          <div class="flex items-center gap-1.5 flex-shrink-0">
            <!-- Toggle -->
            <form method="POST" action="/admin/links/<%= link.id %>/toggle" class="inline">
              <button 
                type="submit" 
                class="p-2 rounded-xl border <%= link.is_active ? 'border-emerald-500/20 text-emerald-400 bg-emerald-500/10' : 'border-slate-800 text-slate-500 bg-slate-950' %>"
              >
                <i class="fa-solid <%= link.is_active ? 'fa-toggle-on' : 'fa-toggle-off' %> text-sm"></i>
              </button>
            </form>

            <!-- Delete -->
            <form method="POST" action="/admin/links/<%= link.id %>/delete" onsubmit="return confirm('Delete this custom slug?');" class="inline">
              <button 
                type="submit" 
                class="p-2 rounded-xl border border-slate-800 bg-slate-950 text-rose-400 hover:bg-rose-500/10"
              >
                <i class="fa-solid fa-trash text-xs"></i>
              </button>
            </form>
          </div>
        </div>

        <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800 text-[11px] font-mono text-slate-300 break-all">
          <span class="text-[10px] text-slate-500 uppercase block font-sans font-semibold mb-0.5">Target Destination</span>
          <%= link.target_url %>
        </div>

        <div class="flex items-center justify-between text-xs pt-1">
          <span class="text-slate-400 font-semibold"><%= link.total_clicks %> clicks</span>
          <div class="flex items-center gap-2">
            <a href="/<%= link.slug %>" target="_blank" class="px-3 py-1.5 bg-indigo-600/20 text-indigo-300 rounded-lg text-xs font-semibold border border-indigo-500/30">
              Visit ↗
            </a>
            <button onclick="copyToClipboard('<%= baseUrl %>/<%= link.slug %>')" class="px-3 py-1.5 bg-slate-800 text-slate-300 rounded-lg text-xs font-semibold border border-slate-700">
              Copy Link
            </button>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Desktop View: Table (>= md) -->
  <div class="hidden md:block bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl mb-8">
    <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between">
      <div>
        <h2 class="text-sm font-bold text-white uppercase tracking-wider">Custom Shortlink Aliases</h2>
        <p class="text-xs text-slate-400">Fixed short URLs that forward directly to designated destinations</p>
      </div>
      <span class="text-xs px-2.5 py-1 bg-slate-950 border border-slate-800 rounded-lg text-slate-400 font-semibold">
        <%= links.length %> Aliases active
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="bg-slate-950/60 text-slate-400 text-xs uppercase tracking-wider border-b border-slate-800">
          <tr>
            <th class="px-5 py-3 font-semibold">Slug / Alias</th>
            <th class="px-5 py-3 font-semibold">Target Destination</th>
            <th class="px-5 py-3 font-semibold text-center">Clicks</th>
            <th class="px-5 py-3 font-semibold text-center">Status</th>
            <th class="px-5 py-3 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% links.forEach(link => { %>
            <tr class="hover:bg-slate-800/30 transition">
              <td class="px-5 py-4">
                <div class="font-bold text-white text-sm"><%= link.title || 'Untitled' %></div>
                <div class="font-mono text-xs text-purple-400 mt-0.5">/<%= link.slug %></div>
              </td>
              <td class="px-5 py-4 max-w-sm truncate font-mono text-xs text-slate-300" title="<%= link.target_url %>">
                <%= link.target_url %>
              </td>
              <td class="px-5 py-4 text-center font-bold text-white">
                <%= link.total_clicks %>
              </td>
              <td class="px-5 py-4 text-center">
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold <%= link.is_active ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20' %>">
                  <%= link.is_active ? 'Active' : 'Disabled' %>
                </span>
              </td>
              <td class="px-5 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <a href="/<%= link.slug %>" target="_blank" class="p-1.5 rounded-lg border border-indigo-500/30 text-indigo-400 hover:bg-indigo-500/10" title="Visit">
                    <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
                  </a>
                  <button onclick="copyToClipboard('<%= baseUrl %>/<%= link.slug %>')" class="p-1.5 rounded-lg border border-slate-800 text-slate-400 hover:text-white" title="Copy">
                    <i class="fa-regular fa-copy text-xs"></i>
                  </button>
                  <form method="POST" action="/admin/links/<%= link.id %>/toggle" class="inline">
                    <button type="submit" class="p-1.5 rounded-lg border <%= link.is_active ? 'border-emerald-500/20 text-emerald-400' : 'border-slate-800 text-slate-500' %>">
                      <i class="fa-solid <%= link.is_active ? 'fa-toggle-on' : 'fa-toggle-off' %> text-sm"></i>
                    </button>
                  </form>
                  <form method="POST" action="/admin/links/<%= link.id %>/delete" onsubmit="return confirm('Delete this slug?');" class="inline">
                    <button type="submit" class="p-1.5 rounded-lg border border-slate-800 text-rose-400 hover:bg-rose-500/10">
                      <i class="fa-solid fa-trash text-xs"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal: New Link -->
<div id="new-link-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-5 sm:p-6 shadow-2xl relative">
    <button onclick="document.getElementById('new-link-modal').classList.add('hidden')" class="absolute top-4 right-4 text-slate-400 hover:text-white p-2">
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>
    <h2 class="text-base sm:text-lg font-bold text-white mb-1">Add Custom Slug</h2>
    <p class="text-xs text-slate-400 mb-4">Route a specific URL slug to any destination.</p>

    <form method="POST" action="/admin/links">
      <div class="space-y-3.5">
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Title</label>
          <input type="text" name="title" placeholder="e.g. Special Direct Link" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Slug *</label>
          <div class="flex items-center">
            <span class="bg-slate-950 border border-r-0 border-slate-800 rounded-l-xl px-3 py-2.5 text-xs text-slate-500 font-mono">/</span>
            <input type="text" name="slug" required placeholder="e.g. direct-verify" class="w-full bg-slate-950 border border-slate-800 rounded-r-xl px-3 py-2.5 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500">
          </div>
        </div>
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Target URL *</label>
          <input type="url" name="target_url" required placeholder="https://destination.example.com" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>
      </div>
      <div class="mt-6 flex justify-end gap-2">
        <button type="button" onclick="document.getElementById('new-link-modal').classList.add('hidden')" class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition">Cancel</button>
        <button type="submit" class="px-5 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-lg shadow-indigo-600/30">Save Slug</button>
      </div>
    </form>
  </div>
</div>

<script>
  function copyToClipboard(text) {
    if (navigator.clipboard) {
      navigator.clipboard.writeText(text).then(() => {
        showToast('Copied: ' + text);
      });
    } else {
      showToast('Copied: ' + text);
    }
  }

  function showToast(msg) {
    const toast = document.createElement('div');
    toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 bg-slate-800 text-white border border-slate-700 text-xs px-4 py-2 rounded-xl shadow-2xl z-50 transition-all';
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
  }
</script>
