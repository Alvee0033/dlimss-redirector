  <script>
    let cartCount = 2;
    let cartTotal = 10.50;

    function toggleCart() {
      document.getElementById('cart-drawer').classList.toggle('hidden');
    }

    function addToCart(name, price) {
      cartCount++;
      cartTotal += price;
      document.getElementById('cart-badge').textContent = cartCount;
      document.getElementById('cart-total').textContent = '$' + cartTotal.toFixed(2);
      
      const itemsList = document.getElementById('cart-items');
      const itemEl = document.createElement('div');
      itemEl.className = 'flex items-center justify-between p-3 bg-slate-50 rounded-xl';
      itemEl.innerHTML = `
        <div>
          <p class="text-sm font-bold text-slate-900">${name}</p>
          <p class="text-xs text-emerald-600 font-bold">$${price.toFixed(2)}</p>
        </div>
        <span class="text-xs font-bold text-slate-400">Qty: 1</span>
      `;
      itemsList.appendChild(itemEl);

      const toast = document.createElement('div');
      toast.className = 'fixed bottom-6 right-6 bg-slate-900 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-2xl z-50';
      toast.textContent = `Added ${name} to basket!`;
      document.body.appendChild(toast);
      setTimeout(() => toast.remove(), 2000);
    }
  </script>
