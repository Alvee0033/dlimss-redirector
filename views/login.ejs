<div class="min-h-[80vh] flex items-center justify-center px-4">
  <div class="max-w-md w-full">
    
    <div class="text-center mb-6">
      <div class="inline-flex p-3 rounded-2xl bg-blue-600 text-white text-2xl mb-3 shadow">
        <i class="fa-solid fa-lock"></i>
      </div>
      <h1 class="text-2xl font-extrabold text-slate-900">Admin Login</h1>
      <p class="text-slate-600 text-sm mt-1">Enter your password to manage redirects</p>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-md">
      <% if (error) { %>
        <div class="mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-300 text-rose-800 text-sm font-semibold flex items-center gap-2">
          <i class="fa-solid fa-triangle-exclamation text-rose-600"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/admin/login" id="login-form" class="space-y-4">
        <div>
          <label class="block text-sm font-bold text-slate-700 mb-1.5">Password</label>
          <div class="relative">
            <input 
              type="password" 
              name="password" 
              id="admin-password-input"
              required 
              autocomplete="current-password"
              placeholder="Enter password..." 
              autofocus
              class="w-full rounded-xl px-4 py-3.5 text-base text-slate-900 pr-11"
            >
            <button 
              type="button" 
              onclick="togglePasswordVisibility()" 
              class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-700 transition"
              title="Show/Hide Password"
            >
              <i class="fa-regular fa-eye text-base" id="pwd-toggle-icon"></i>
            </button>
          </div>
        </div>

        <!-- Remember Password -->
        <div class="flex items-center justify-between pt-1">
          <label class="flex items-center gap-2.5 cursor-pointer select-none">
            <input 
              type="checkbox" 
              name="remember_me" 
              id="remember-me-checkbox"
              value="1"
              class="w-5 h-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer"
            >
            <span class="text-sm font-bold text-slate-700">Remember password</span>
          </label>
        </div>

        <button 
          type="submit" 
          class="w-full py-3.5 px-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl text-base font-bold transition shadow flex items-center justify-center gap-2"
        >
          <span>Login</span>
          <i class="fa-solid fa-arrow-right text-sm"></i>
        </button>
      </form>

      <div class="mt-5 pt-5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-400">
        <span>MultiVerify</span>
        <button 
          type="button" 
          onclick="clearSavedPassword()" 
          id="clear-pwd-btn"
          class="text-rose-600 hover:underline font-bold hidden"
        >
          Forget saved password
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  function togglePasswordVisibility() {
    const input = document.getElementById('admin-password-input');
    const icon = document.getElementById('pwd-toggle-icon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'fa-regular fa-eye-slash text-base';
    } else {
      input.type = 'password';
      icon.className = 'fa-regular fa-eye text-base';
    }
  }

  (function handleRememberPassword() {
    const pwdInput = document.getElementById('admin-password-input');
    const remCheckbox = document.getElementById('remember-me-checkbox');
    const clearBtn = document.getElementById('clear-pwd-btn');
    const form = document.getElementById('login-form');

    const savedPwd = localStorage.getItem('mv_admin_saved_pwd');
    if (savedPwd) {
      pwdInput.value = savedPwd;
      remCheckbox.checked = true;
      if (clearBtn) clearBtn.classList.remove('hidden');
    }

    form.addEventListener('submit', function() {
      if (remCheckbox.checked) {
        localStorage.setItem('mv_admin_saved_pwd', pwdInput.value);
      } else {
        localStorage.removeItem('mv_admin_saved_pwd');
      }
    });
  })();

  function clearSavedPassword() {
    localStorage.removeItem('mv_admin_saved_pwd');
    const pwdInput = document.getElementById('admin-password-input');
    const remCheckbox = document.getElementById('remember-me-checkbox');
    const clearBtn = document.getElementById('clear-pwd-btn');
    pwdInput.value = '';
    remCheckbox.checked = false;
    if (clearBtn) clearBtn.classList.add('hidden');
  }
</script>
