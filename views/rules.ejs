<div class="max-w-5xl mx-auto px-4 py-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">QR Redirect Links</h1>
      <p class="text-slate-500 text-sm mt-0.5">
        When someone scans these QR codes, this is where they land.
      </p>
    </div>

    <button 
      onclick="document.getElementById('new-rule-modal').classList.remove('hidden')"
      class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold px-4 py-2.5 rounded-xl transition flex items-center gap-2 self-start sm:self-auto shadow-sm"
    >
      <i class="fa-solid fa-plus text-xs"></i>
      <span>Add New Link</span>
    </button>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="mb-5 p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center gap-2">
      <i class="fa-solid fa-circle-check text-emerald-600"></i>
      <span><%= success %></span>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-semibold flex items-center gap-2">
      <i class="fa-solid fa-triangle-exclamation text-rose-600"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Search Filter -->
  <div class="mb-5 relative">
    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
      <i class="fa-solid fa-magnifying-glass text-sm"></i>
    </div>
    <input 
      type="text" 
      id="rule-search" 
      oninput="filterRules()" 
      placeholder="Search by country or website name..." 
      class="w-full rounded-xl pl-10 pr-4 py-2.5 text-sm text-slate-900 shadow-sm"
    >
  </div>

  <!-- Clear Plain English List -->
  <div class="space-y-3">
    <% sites.forEach(site => { %>
      <div class="rule-item bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-sm hover:border-slate-300 transition" data-search="<%= site.title %> <%= site.key_name %> <%= site.base_url %>">
        
        <!-- Header row -->
        <div class="flex items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-2">
            <h2 class="font-extrabold text-base sm:text-lg text-slate-900"><%= site.title %></h2>
            <% if (site.is_active) { %>
              <span class="text-xs font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">On</span>
            <% } else { %>
              <span class="text-xs font-bold text-slate-500 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-full">Off</span>
            <% } %>
          </div>

          <!-- Total Scans -->
          <span class="text-xs font-bold text-slate-500 bg-slate-50 border border-slate-200 px-2.5 py-1 rounded-lg">
            Scanned <%= site.total_clicks %> times
          </span>
        </div>

        <!-- Plain English Explanation Box -->
        <div class="bg-slate-50 rounded-xl p-3 border border-slate-100 text-xs sm:text-sm space-y-1.5 font-sans mb-4">
          <div class="flex items-center gap-2">
            <span class="font-bold text-slate-500 w-28 sm:w-32 flex-shrink-0">Scanned QR URL:</span>
            <span class="font-mono text-blue-700 font-bold break-all">dlimss.com/<%= site.key_name %>/(ID)</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-bold text-slate-500 w-28 sm:w-32 flex-shrink-0">Sends visitor to:</span>
            <span class="font-mono text-slate-700 truncate" title="<%= site.base_url %>"><%= site.base_url %></span>
          </div>
        </div>

        <!-- Action Row -->
        <div class="flex items-center justify-between gap-2 pt-1 border-t border-slate-100 flex-wrap">
          <div class="flex items-center gap-2">
            <a 
              href="/<%= site.key_name %>/SAMPLE-12345" 
              target="_blank" 
              class="px-3.5 py-1.5 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg text-xs font-bold transition flex items-center gap-1.5"
            >
              <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
              <span>Test Link</span>
            </a>

            <!-- Toggle On/Off -->
            <form method="POST" action="/admin/sites/<%= site.id %>/toggle" class="inline">
              <button 
                type="submit" 
                class="px-3 py-1.5 border rounded-lg text-xs font-bold transition <%= site.is_active ? 'border-slate-200 text-slate-600 hover:bg-slate-100' : 'border-emerald-300 text-emerald-700 bg-emerald-50' %>"
              >
                <%= site.is_active ? 'Turn Off' : 'Turn On' %>
              </button>
            </form>
          </div>

          <div class="flex items-center gap-1">
            <button 
              type="button" 
              onclick='openEditRuleModal(<%= JSON.stringify(site) %>)'
              class="p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition"
              title="Edit"
            >
              <i class="fa-solid fa-pen text-xs"></i>
            </button>

            <form method="POST" action="/admin/sites/<%= site.id %>/delete" onsubmit="return confirm('Delete this link?');" class="inline">
              <button 
                type="submit" 
                class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition"
                title="Delete"
              >
                <i class="fa-solid fa-trash text-xs"></i>
              </button>
            </form>
          </div>
        </div>

      </div>
    <% }) %>
  </div>

</div>

<!-- Modal: New Rule -->
<div id="new-rule-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl relative max-h-[90vh] overflow-y-auto">
    <button 
      onclick="document.getElementById('new-rule-modal').classList.add('hidden')"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-2"
    >
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>

    <h2 class="text-lg font-bold text-slate-900 mb-1">Add QR Link</h2>
    <p class="text-xs text-slate-500 mb-4">Set where the QR code sends people.</p>

    <form method="POST" action="/admin/sites">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Website or Country Name</label>
          <input 
            type="text" 
            name="title" 
            required
            placeholder="e.g. Pakistan License or Dubai RTA"
            class="w-full rounded-xl px-3 py-2 text-sm text-slate-900"
          >
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">QR Short Word</label>
          <div class="flex items-center">
            <span class="bg-slate-100 border border-r-0 border-slate-300 rounded-l-xl px-3 py-2 text-sm text-slate-500 font-mono">dlimss.com/</span>
            <input 
              type="text" 
              name="key_name" 
              required
              placeholder="pakistan" 
              class="w-full rounded-r-xl px-3 py-2 text-sm text-slate-900 font-mono"
            >
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Destination Web Address</label>
          <input 
            type="url" 
            name="base_url" 
            required 
            placeholder="https://destination-website.com/verify"
            class="w-full rounded-xl px-3 py-2 text-sm text-slate-900 font-mono"
          >
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">How ID is added</label>
            <select name="append_mode" id="rule_append_mode" onchange="toggleRuleParamField(this.value, 'rule_query_param_div')" class="w-full rounded-xl px-2.5 py-2 text-xs text-slate-900">
              <option value="query">As parameter (?id=123)</option>
              <option value="path">As slash (/123)</option>
            </select>
          </div>

          <div id="rule_query_param_div">
            <label class="block text-xs font-bold text-slate-700 mb-1">Parameter Name</label>
            <input 
              type="text" 
              name="query_param_name" 
              value="id"
              placeholder="e.g. id, lic"
              class="w-full rounded-xl px-3 py-2 text-xs text-slate-900 font-mono"
            >
          </div>
        </div>
      </div>

      <div class="mt-5 flex justify-end gap-2">
        <button 
          type="button" 
          onclick="document.getElementById('new-rule-modal').classList.add('hidden')"
          class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100"
        >
          Cancel
        </button>
        <button 
          type="submit" 
          class="px-5 py-2 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white transition shadow-sm"
        >
          Save Link
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Edit Rule -->
<div id="edit-rule-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl relative max-h-[90vh] overflow-y-auto">
    <button 
      onclick="document.getElementById('edit-rule-modal').classList.add('hidden')"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-2"
    >
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>

    <h2 class="text-lg font-bold text-slate-900 mb-1">Edit QR Link</h2>
    <p class="text-xs text-slate-500 mb-4">Change where this QR code directs visitors.</p>

    <form id="edit-rule-form" method="POST" action="">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Name</label>
          <input 
            type="text" 
            id="edit-rule-title" 
            name="title" 
            required
            class="w-full rounded-xl px-3 py-2 text-sm text-slate-900"
          >
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">QR Short Word</label>
          <div class="flex items-center">
            <span class="bg-slate-100 border border-r-0 border-slate-300 rounded-l-xl px-3 py-2 text-sm text-slate-500 font-mono">dlimss.com/</span>
            <input 
              type="text" 
              id="edit-rule-key" 
              name="key_name" 
              required
              class="w-full rounded-r-xl px-3 py-2 text-sm text-slate-900 font-mono"
            >
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Destination Web Address</label>
          <input 
            type="url" 
            id="edit-rule-base" 
            name="base_url" 
            required 
            class="w-full rounded-xl px-3 py-2 text-sm text-slate-900 font-mono"
          >
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">How ID is added</label>
            <select name="append_mode" id="edit-rule-mode" onchange="toggleRuleParamField(this.value, 'edit_rule_query_param_div')" class="w-full rounded-xl px-2.5 py-2 text-xs text-slate-900">
              <option value="query">As parameter (?id=123)</option>
              <option value="path">As slash (/123)</option>
            </select>
          </div>

          <div id="edit_rule_query_param_div">
            <label class="block text-xs font-bold text-slate-700 mb-1">Parameter Name</label>
            <input 
              type="text" 
              id="edit-rule-param" 
              name="query_param_name" 
              class="w-full rounded-xl px-3 py-2 text-xs text-slate-900 font-mono"
            >
          </div>
        </div>
      </div>

      <div class="mt-5 flex justify-end gap-2">
        <button 
          type="button" 
          onclick="document.getElementById('edit-rule-modal').classList.add('hidden')"
          class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100"
        >
          Cancel
        </button>
        <button 
          type="submit" 
          class="px-5 py-2 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white transition shadow-sm"
        >
          Update Link
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleRuleParamField(val, divId) {
    const el = document.getElementById(divId);
    if (el) {
      el.style.display = (val === 'query') ? 'block' : 'none';
    }
  }

  function openEditRuleModal(site) {
    document.getElementById('edit-rule-form').action = '/admin/sites/' + site.id + '/edit';
    document.getElementById('edit-rule-title').value = site.title;
    document.getElementById('edit-rule-key').value = site.key_name;
    document.getElementById('edit-rule-base').value = site.base_url;
    document.getElementById('edit-rule-mode').value = site.append_mode;
    document.getElementById('edit-rule-param').value = site.query_param_name || 'id';
    toggleRuleParamField(site.append_mode, 'edit_rule_query_param_div');
    document.getElementById('edit-rule-modal').classList.remove('hidden');
  }

  function filterRules() {
    const q = (document.getElementById('rule-search').value || '').toLowerCase();
    const items = document.querySelectorAll('.rule-item');
    items.forEach(item => {
      const txt = (item.getAttribute('data-search') || '').toLowerCase();
      item.style.display = txt.includes(q) ? '' : 'none';
    });
  }
</script>
