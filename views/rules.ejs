<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-xs font-semibold mb-2">
        <i class="fa-solid fa-sliders"></i>
        <span>Routing Engine</span>
      </div>
      <h1 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Site Forwarding Rules</h1>
      <p class="text-slate-400 text-xs sm:text-sm mt-0.5">
        Configure how incoming dynamic QR parameters and path extensions are mapped to destination endpoints.
      </p>
    </div>

    <!-- Quick Action -->
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <a 
        href="/admin/portals" 
        class="bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-300 border border-emerald-500/30 text-xs font-semibold px-3.5 py-2.5 rounded-xl transition flex items-center gap-2"
      >
        <i class="fa-solid fa-compass text-xs"></i>
        <span>Launch Portals</span>
      </a>

      <button 
        onclick="document.getElementById('new-rule-modal').classList.remove('hidden')"
        class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold px-4 py-2.5 rounded-xl transition shadow-lg shadow-indigo-600/30 flex items-center gap-2"
      >
        <i class="fa-solid fa-plus text-xs"></i>
        <span>Add Rule</span>
      </button>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="mb-4 p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs sm:text-sm flex items-center gap-2.5">
      <i class="fa-solid fa-circle-check text-sm flex-shrink-0"></i>
      <span><%= success %></span>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-4 p-3.5 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs sm:text-sm flex items-center gap-2.5">
      <i class="fa-solid fa-triangle-exclamation text-sm flex-shrink-0"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Search / Quick Filter -->
  <div class="mb-6 relative">
    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
      <i class="fa-solid fa-magnifying-glass text-xs"></i>
    </div>
    <input 
      type="text" 
      id="rule-search" 
      oninput="filterRules()" 
      placeholder="Filter rules by key, target domain or parameter name..." 
      class="w-full bg-slate-900/90 border border-slate-800 rounded-xl pl-10 pr-4 py-3 text-sm text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
    >
  </div>

  <!-- Mobile View: Rule Cards (< md) -->
  <div class="block md:hidden space-y-3 mb-8">
    <% sites.forEach(site => { %>
      <div class="rule-card bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-md space-y-3" data-search="<%= site.title %> <%= site.key_name %> <%= site.base_url %>">
        <div class="flex items-start justify-between gap-2">
          <div class="flex-1 min-w-0">
            <h3 class="font-bold text-white text-sm truncate"><%= site.title %></h3>
            <div class="flex items-center gap-1.5 mt-1 flex-wrap">
              <span class="font-mono text-xs text-indigo-400 bg-indigo-500/10 px-2 py-0.5 rounded border border-indigo-500/20">
                /<%= site.key_name %>/:id
              </span>
              <span class="text-[10px] text-slate-400 uppercase font-semibold bg-slate-800 px-1.5 py-0.5 rounded">
                Mode: <%= site.append_mode %>
              </span>
            </div>
          </div>

          <div class="flex items-center gap-1.5 flex-shrink-0">
            <form method="POST" action="/admin/sites/<%= site.id %>/toggle" class="inline">
              <button 
                type="submit" 
                class="p-2 rounded-xl border <%= site.is_active ? 'border-emerald-500/20 text-emerald-400 bg-emerald-500/10' : 'border-slate-800 text-slate-500 bg-slate-950' %>"
                title="Toggle Active"
              >
                <i class="fa-solid <%= site.is_active ? 'fa-toggle-on' : 'fa-toggle-off' %> text-sm"></i>
              </button>
            </form>

            <button 
              type="button" 
              onclick='openEditRuleModal(<%= JSON.stringify(site) %>)'
              class="p-2 rounded-xl border border-slate-800 bg-slate-950 text-slate-400 hover:text-white"
              title="Edit Rule"
            >
              <i class="fa-solid fa-pen-to-square text-xs"></i>
            </button>

            <form method="POST" action="/admin/sites/<%= site.id %>/delete" onsubmit="return confirm('Delete this routing rule?');" class="inline">
              <button 
                type="submit" 
                class="p-2 rounded-xl border border-slate-800 bg-slate-950 text-rose-400 hover:bg-rose-500/10"
                title="Delete Rule"
              >
                <i class="fa-solid fa-trash text-xs"></i>
              </button>
            </form>
          </div>
        </div>

        <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800/80 text-[11px] font-mono text-slate-300 break-all">
          <span class="text-[10px] text-slate-500 uppercase font-sans font-semibold block mb-0.5">Target Destination URL</span>
          <%= site.base_url %>
        </div>

        <div class="bg-slate-950/60 p-2.5 rounded-xl border border-slate-800/60 text-xs space-y-1">
          <div class="flex items-center justify-between text-slate-400 text-[11px]">
            <span>Rewrite Parameter:</span>
            <span class="font-mono text-indigo-300 font-bold"><%= site.append_mode === 'query' ? `?${site.query_param_name}=ID` : `/${site.key_name}/ID` %></span>
          </div>
          <div class="flex items-center justify-between text-slate-400 text-[11px]">
            <span>Total Traffic Scans:</span>
            <span class="font-semibold text-white"><%= site.total_clicks %> hits</span>
          </div>
        </div>

        <div class="flex items-center justify-between gap-2 pt-1">
          <a 
            href="/<%= site.key_name %>/TEST-12345" 
            target="_blank" 
            class="flex-1 py-2 px-3 rounded-xl text-xs font-semibold bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 flex items-center justify-center gap-1.5"
          >
            <i class="fa-solid fa-bolt text-amber-400 text-xs"></i>
            <span>Test Route</span>
          </a>
          <button 
            type="button" 
            onclick="copyToClipboard('<%= baseUrl %>/<%= site.key_name %>/')"
            class="py-2 px-3 rounded-xl text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700 flex items-center justify-center gap-1.5"
          >
            <i class="fa-regular fa-copy"></i>
            <span>Copy URL</span>
          </button>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Desktop View: Comprehensive Rules Table (>= md) -->
  <div class="hidden md:block bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl mb-8">
    <div class="p-4 sm:p-5 border-b border-slate-800 flex items-center justify-between">
      <div>
        <h2 class="text-sm font-bold text-white uppercase tracking-wider">Active Forwarding Rules Engine</h2>
        <p class="text-xs text-slate-400">Deterministic resolution table for dynamic QR scans and query rewriting</p>
      </div>
      <span class="text-xs px-2.5 py-1 bg-slate-950 border border-slate-800 rounded-lg text-slate-400 font-semibold">
        <%= sites.length %> Rules configured
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm" id="rules-table">
        <thead class="bg-slate-950/60 text-slate-400 text-xs uppercase tracking-wider border-b border-slate-800">
          <tr>
            <th class="px-5 py-3 font-semibold">Match Key</th>
            <th class="px-5 py-3 font-semibold">Destination URL</th>
            <th class="px-5 py-3 font-semibold">Append Strategy</th>
            <th class="px-5 py-3 font-semibold text-center">Hits</th>
            <th class="px-5 py-3 font-semibold text-center">Status</th>
            <th class="px-5 py-3 font-semibold text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          <% sites.forEach(site => { %>
            <tr class="hover:bg-slate-800/30 transition rule-row" data-search="<%= site.title %> <%= site.key_name %> <%= site.base_url %>">
              <td class="px-5 py-4">
                <div class="font-bold text-white text-sm"><%= site.title %></div>
                <div class="flex items-center gap-2 mt-1">
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
                    /<%= site.key_name %>/:id
                  </span>
                </div>
              </td>

              <td class="px-5 py-4 max-w-sm">
                <div class="font-mono text-xs text-slate-300 truncate" title="<%= site.base_url %>">
                  <%= site.base_url %>
                </div>
                <div class="text-[11px] text-slate-500 mt-1">
                  QR Pattern: <code class="text-indigo-400 bg-slate-950 px-1 py-0.5 rounded"><%= baseUrl %>/<%= site.key_name %>/{ID}</code>
                </div>
              </td>

              <td class="px-5 py-4">
                <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-950 border border-slate-800 text-xs">
                  <span class="text-slate-400 font-semibold uppercase"><%= site.append_mode %></span>
                  <span class="text-slate-600">&bull;</span>
                  <span class="text-indigo-400 font-mono"><%= site.append_mode === 'query' ? `?${site.query_param_name}=ID` : `/${site.key_name}/ID` %></span>
                </div>
              </td>

              <td class="px-5 py-4 text-center">
                <span class="text-sm font-bold text-white"><%= site.total_clicks %></span>
              </td>

              <td class="px-5 py-4 text-center">
                <% if (site.is_active) { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                    Active
                  </span>
                <% } else { %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20">
                    Paused
                  </span>
                <% } %>
              </td>

              <td class="px-5 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <a 
                    href="/<%= site.key_name %>/TEST-12345" 
                    target="_blank"
                    class="p-1.5 rounded-lg border border-slate-800 text-amber-400 hover:bg-amber-500/10 hover:border-amber-500/30 transition"
                    title="Simulate redirect"
                  >
                    <i class="fa-solid fa-bolt text-xs"></i>
                  </a>

                  <form method="POST" action="/admin/sites/<%= site.id %>/toggle" class="inline">
                    <button 
                      type="submit" 
                      title="<%= site.is_active ? 'Pause' : 'Activate' %> rule"
                      class="p-1.5 rounded-lg border <%= site.is_active ? 'border-emerald-500/20 text-emerald-400 hover:bg-emerald-500/10' : 'border-slate-800 text-slate-500 hover:bg-slate-800' %> transition"
                    >
                      <i class="fa-solid <%= site.is_active ? 'fa-toggle-on text-base' : 'fa-toggle-off text-base' %>"></i>
                    </button>
                  </form>

                  <button 
                    type="button" 
                    onclick='openEditRuleModal(<%= JSON.stringify(site) %>)'
                    class="p-1.5 rounded-lg border border-slate-800 text-slate-400 hover:text-white hover:bg-slate-800 transition"
                    title="Edit Rule"
                  >
                    <i class="fa-solid fa-pen-to-square text-xs"></i>
                  </button>

                  <form method="POST" action="/admin/sites/<%= site.id %>/delete" onsubmit="return confirm('Delete this forwarding rule?');" class="inline">
                    <button 
                      type="submit" 
                      class="p-1.5 rounded-lg border border-slate-800 text-rose-400 hover:bg-rose-500/10 hover:border-rose-500/30 transition"
                      title="Delete Rule"
                    >
                      <i class="fa-solid fa-trash text-xs"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<!-- Modal: New Rule -->
<div id="new-rule-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-5 sm:p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
    <button 
      onclick="document.getElementById('new-rule-modal').classList.add('hidden')"
      class="absolute top-4 right-4 text-slate-400 hover:text-white p-2"
    >
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>

    <h2 class="text-base sm:text-lg font-bold text-white mb-1">Add Forwarding Rule</h2>
    <p class="text-xs text-slate-400 mb-4">Define incoming matching slug and target URL mapping.</p>

    <form method="POST" action="/admin/sites">
      <div class="space-y-3.5">
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Rule / Site Title *</label>
          <input 
            type="text" 
            name="title" 
            required
            placeholder="e.g. Dubai RTA License or Islamabad DLIMS"
            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Incoming Key (Slug) *</label>
          <div class="flex items-center">
            <span class="bg-slate-950 border border-r-0 border-slate-800 rounded-l-xl px-3 py-2.5 text-xs text-slate-500 font-mono">/</span>
            <input 
              type="text" 
              name="key_name" 
              required
              placeholder="e.g. rta, dlims, verify" 
              class="w-full bg-slate-950 border border-slate-800 rounded-r-xl px-3 py-2.5 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Target Base URL *</label>
          <input 
            type="url" 
            name="base_url" 
            required 
            placeholder="https://destination.example.com"
            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Parameter Append Mode</label>
            <select name="append_mode" id="rule_append_mode" onchange="toggleRuleParamField(this.value, 'rule_query_param_div')" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="query">Query Parameter (?param=ID)</option>
              <option value="path">Path Extension (/base/url/ID)</option>
            </select>
          </div>

          <div id="rule_query_param_div">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Parameter Query Key</label>
            <input 
              type="text" 
              name="query_param_name" 
              value="id"
              placeholder="e.g. id, permitNumber, lic"
              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
          </div>
        </div>
      </div>

      <div class="mt-6 flex justify-end gap-2">
        <button 
          type="button" 
          onclick="document.getElementById('new-rule-modal').classList.add('hidden')"
          class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition"
        >
          Cancel
        </button>
        <button 
          type="submit" 
          class="px-5 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-lg shadow-indigo-600/30"
        >
          Save Forwarding Rule
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Modal: Edit Rule -->
<div id="edit-rule-modal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl max-w-lg w-full p-5 sm:p-6 shadow-2xl relative max-h-[90vh] overflow-y-auto">
    <button 
      onclick="document.getElementById('edit-rule-modal').classList.add('hidden')"
      class="absolute top-4 right-4 text-slate-400 hover:text-white p-2"
    >
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>

    <h2 class="text-base sm:text-lg font-bold text-white mb-1">Edit Forwarding Rule</h2>
    <p class="text-xs text-slate-400 mb-4">Modify destination target and URL concatenation behavior.</p>

    <form id="edit-rule-form" method="POST" action="">
      <div class="space-y-3.5">
        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Rule / Site Title</label>
          <input 
            type="text" 
            id="edit-rule-title" 
            name="title" 
            required
            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Incoming Key (Slug)</label>
          <div class="flex items-center">
            <span class="bg-slate-950 border border-r-0 border-slate-800 rounded-l-xl px-3 py-2.5 text-xs text-slate-500 font-mono">/</span>
            <input 
              type="text" 
              id="edit-rule-key" 
              name="key_name" 
              required
              class="w-full bg-slate-950 border border-slate-800 rounded-r-xl px-3 py-2.5 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Target Base URL</label>
          <input 
            type="url" 
            id="edit-rule-base" 
            name="base_url" 
            required 
            class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-sm text-white font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500"
          >
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Parameter Append Mode</label>
            <select name="append_mode" id="edit-rule-mode" onchange="toggleRuleParamField(this.value, 'edit_rule_query_param_div')" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white focus:outline-none focus:ring-2 focus:ring-indigo-500">
              <option value="query">Query Parameter (?param=ID)</option>
              <option value="path">Path Extension (/base/url/ID)</option>
            </select>
          </div>

          <div id="edit_rule_query_param_div">
            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1">Parameter Query Key</label>
            <input 
              type="text" 
              id="edit-rule-param" 
              name="query_param_name" 
              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2.5 text-xs text-white font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
          </div>
        </div>
      </div>

      <div class="mt-6 flex justify-end gap-2">
        <button 
          type="button" 
          onclick="document.getElementById('edit-rule-modal').classList.add('hidden')"
          class="px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:text-white hover:bg-slate-800 transition"
        >
          Cancel
        </button>
        <button 
          type="submit" 
          class="px-5 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 hover:bg-indigo-500 text-white transition shadow-lg shadow-indigo-600/30"
        >
          Update Rule
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleRuleParamField(val, divId) {
    const el = document.getElementById(divId);
    if (el) {
      el.style.display = (val === 'query') ? 'block' : 'none';
    }
  }

  function openEditRuleModal(site) {
    document.getElementById('edit-rule-form').action = '/admin/sites/' + site.id + '/edit';
    document.getElementById('edit-rule-title').value = site.title;
    document.getElementById('edit-rule-key').value = site.key_name;
    document.getElementById('edit-rule-base').value = site.base_url;
    document.getElementById('edit-rule-mode').value = site.append_mode;
    document.getElementById('edit-rule-param').value = site.query_param_name || 'id';
    toggleRuleParamField(site.append_mode, 'edit_rule_query_param_div');
    document.getElementById('edit-rule-modal').classList.remove('hidden');
  }

  function filterRules() {
    const q = (document.getElementById('rule-search').value || '').toLowerCase();
    const rows = document.querySelectorAll('.rule-row');
    rows.forEach(r => {
      const txt = (r.getAttribute('data-search') || '').toLowerCase();
      r.style.display = txt.includes(q) ? '' : 'none';
    });
    const cards = document.querySelectorAll('.rule-card');
    cards.forEach(c => {
      const txt = (c.getAttribute('data-search') || '').toLowerCase();
      c.style.display = txt.includes(q) ? '' : 'none';
    });
  }
</script>
