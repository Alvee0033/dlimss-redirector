<div class="max-w-5xl mx-auto px-4 py-8">

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-extrabold text-slate-900">Dashboard</h1>
      <p class="text-slate-500 text-sm mt-0.5">
        Overview of all active QR codes and destination sites.
      </p>
    </div>

    <button 
      onclick="document.getElementById('new-site-modal').classList.remove('hidden')"
      class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold px-4 py-2.5 rounded-xl transition shadow-sm flex items-center gap-2 self-start sm:self-auto"
    >
      <i class="fa-solid fa-plus text-xs"></i>
      <span>Add New Site</span>
    </button>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="mb-5 p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center gap-2">
      <i class="fa-solid fa-circle-check text-emerald-600"></i>
      <span><%= success %></span>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm font-semibold flex items-center gap-2">
      <i class="fa-solid fa-triangle-exclamation text-rose-600"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Summary Numbers -->
  <div class="grid grid-cols-3 gap-3 sm:gap-4 mb-6">
    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
      <span class="text-xs font-bold text-slate-500">Total Sites</span>
      <p class="text-2xl font-extrabold text-slate-900 mt-0.5"><%= sites.length %></p>
    </div>
    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
      <span class="text-xs font-bold text-slate-500">Active</span>
      <p class="text-2xl font-extrabold text-emerald-600 mt-0.5"><%= sites.filter(s => s.is_active).length %></p>
    </div>
    <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
      <span class="text-xs font-bold text-slate-500">Total Scans</span>
      <p class="text-2xl font-extrabold text-blue-600 mt-0.5"><%= sites.reduce((acc, s) => acc + (s.total_clicks || 0), 0) %></p>
    </div>
  </div>

  <!-- Sites List -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="p-4 border-b border-slate-100 flex items-center justify-between">
      <h2 class="text-sm font-bold text-slate-800">Your Websites (<%= sites.length %>)</h2>
      <a href="/admin/rules" class="text-xs font-bold text-blue-600 hover:underline">Manage QR Links &rarr;</a>
    </div>

    <div class="divide-y divide-slate-100">
      <% sites.forEach(site => { %>
        <div class="p-4 hover:bg-slate-50 transition flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-sm">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-bold text-slate-900"><%= site.title %></span>
              <span class="font-mono text-xs text-blue-700 bg-blue-50 px-2 py-0.5 rounded font-bold">
                /<%= site.key_name %>
              </span>
              <% if (site.is_active) { %>
                <span class="text-[11px] font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full">On</span>
              <% } else { %>
                <span class="text-[11px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">Off</span>
              <% } %>
            </div>
            <div class="text-xs text-slate-500 font-mono mt-1 truncate" title="<%= site.base_url %>">
              <%= site.base_url %>
            </div>
          </div>

          <div class="flex items-center gap-2 self-start sm:self-auto">
            <a 
              href="<%= site.base_url %>" 
              target="_blank" 
              class="px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 rounded-lg text-xs font-bold transition flex items-center gap-1.5"
            >
              <span>Visit</span>
              <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
            </a>

            <button 
              type="button" 
              onclick="showQR(<%= site.id %>, '<%= site.key_name %>', '<%= site.title %>')"
              class="px-3 py-1.5 bg-blue-50 text-blue-700 hover:bg-blue-100 rounded-lg text-xs font-bold transition flex items-center gap-1"
            >
              <i class="fa-solid fa-qrcode text-xs"></i>
              <span>QR</span>
            </button>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

</div>

<!-- Modal: New Site -->
<div id="new-site-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl relative max-h-[90vh] overflow-y-auto">
    <button 
      onclick="document.getElementById('new-site-modal').classList.add('hidden')"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-2"
    >
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>

    <h2 class="text-lg font-bold text-slate-900 mb-1">Add Website</h2>
    <p class="text-xs text-slate-500 mb-4">Set up a new QR redirect link.</p>

    <form method="POST" action="/admin/sites">
      <div class="space-y-3.5">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Name</label>
          <input 
            type="text" 
            name="title" 
            required
            placeholder="e.g. Pakistan DLIMS"
            class="w-full rounded-xl px-3 py-2 text-sm text-slate-900"
          >
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">QR Link Keyword</label>
          <div class="flex items-center">
            <span class="bg-slate-100 border border-r-0 border-slate-300 rounded-l-xl px-3 py-2 text-sm text-slate-500 font-mono">dlimss.com/</span>
            <input 
              type="text" 
              name="key_name" 
              required
              placeholder="pakistan" 
              class="w-full rounded-r-xl px-3 py-2 text-sm text-slate-900 font-mono"
            >
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Destination Web Address</label>
          <input 
            type="url" 
            name="base_url" 
            required 
            placeholder="https://verify.example.com"
            class="w-full rounded-xl px-3 py-2 text-sm text-slate-900 font-mono"
          >
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">How ID is added</label>
            <select name="append_mode" id="append_mode_select" onchange="toggleParamField(this.value, 'query_param_div')" class="w-full rounded-xl px-2.5 py-2 text-xs text-slate-900">
              <option value="query">Parameter (?id=)</option>
              <option value="path">Slash (/id)</option>
            </select>
          </div>

          <div id="query_param_div">
            <label class="block text-xs font-bold text-slate-700 mb-1">Parameter Name</label>
            <input 
              type="text" 
              name="query_param_name" 
              value="id"
              placeholder="id"
              class="w-full rounded-xl px-3 py-2 text-xs text-slate-900 font-mono"
            >
          </div>
        </div>
      </div>

      <div class="mt-5 flex justify-end gap-2">
        <button 
          type="button" 
          onclick="document.getElementById('new-site-modal').classList.add('hidden')"
          class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100"
        >
          Cancel
        </button>
        <button 
          type="submit" 
          class="px-5 py-2 rounded-xl text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white transition shadow-sm"
        >
          Save
        </button>
      </div>
    </form>
  </div>
</div>

<!-- QR Modal -->
<div id="qr-modal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-2xl max-w-sm w-full p-6 shadow-xl relative text-center">
    <button 
      onclick="document.getElementById('qr-modal').classList.add('hidden')"
      class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-2"
    >
      <i class="fa-solid fa-xmark text-lg"></i>
    </button>

    <h2 class="text-base font-bold text-slate-900 mb-1" id="qr-label">QR Code</h2>
    <p class="text-xs text-slate-500 mb-4 font-mono break-all" id="qr-url-label"></p>

    <div class="flex justify-center mb-4">
      <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 inline-block">
        <img id="qr-image" src="" alt="QR Code" class="w-48 h-48 block mx-auto">
      </div>
    </div>

    <a 
      id="qr-download-btn"
      href="#"
      download="qr.png"
      class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white transition shadow-sm"
    >
      <i class="fa-solid fa-download text-xs"></i>
      Download Image
    </a>
  </div>
</div>

<script>
  function toggleParamField(val, divId) {
    const el = document.getElementById(divId);
    if (el) {
      el.style.display = (val === 'query') ? 'block' : 'none';
    }
  }

  async function showQR(siteId, keyName, title) {
    const modal = document.getElementById('qr-modal');
    const img = document.getElementById('qr-image');
    const label = document.getElementById('qr-label');
    const urlLabel = document.getElementById('qr-url-label');
    const dlBtn = document.getElementById('qr-download-btn');

    img.src = '';
    label.textContent = title;
    urlLabel.textContent = 'Loading...';
    modal.classList.remove('hidden');

    try {
      const resp = await fetch(`/admin/sites/${siteId}/qr`);
      const data = await resp.json();
      img.src = data.qr;
      urlLabel.textContent = data.url + '{ID}';
      dlBtn.href = data.qr;
      dlBtn.download = `qr-${keyName}.png`;
    } catch(e) {
      urlLabel.textContent = 'Error';
    }
  }
</script>
